{"schema_version": 1, "segment_epoch": 1792275060, "covers_from": "2026-10-17T22:11:00+00:00", "covers_to": "2026-10-17T22:12:00+00:00", "next_epoch": 1792275120, "schedule": [{"starts_at": "2026-10-17T22:11:00+00:00", "duration_seconds": 8, "type": "padding", "queue_number": 23677, "sprite_key": "beaver_culture", "district": "zhongshan", "topic": "城市修繕", "content": "希望長安國小外面的被砍光的樹可以重新栽種起來", "display_name": "中山代表 No.23,677", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-17T22:11:08+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 5147, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "台北是對職業女性極不友善的城市，穿高跟鞋基本上寸步難行，鞋跟甚至會卡在捷運手扶梯上縫隙，差點夾死", "display_name": "大安代表 Sophia Feng", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-17T22:11:23+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 28126, "sprite_key": "leopardcat_oldtown", "district": "wanhua", "topic": "環境", "content": "蟑螂！！！也太多了吧！！！", "display_name": "萬華代表 No.28,126", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-17T22:11:28+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 25432, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "拜託！ 把樹種回來吧。而且不能打混，要有一致性，不要亂種", "display_name": "大安代表 No.25,432", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-17T22:11:37+00:00", "duration_seconds": 23, "type": "padding", "queue_number": 21595, "sprite_key": "leopardcat_business", "district": "xinyi", "topic": "環境", "content": "台北市普遍來說許多地方街道在進入晚上後都有蟑螂出沒問題。我八月底回台南老家快兩週，台南的街道乾淨許多", "display_name": "信義代表 No.21,595", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 5147, "sprite_key": "leopardcat_culture", "display_name": "大安代表 Sophia Feng", "district": "daan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 28126, "sprite_key": "leopardcat_oldtown", "display_name": "萬華代表 No.28,126", "district": "wanhua", "is_replay": true,