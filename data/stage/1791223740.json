{"schema_version": 1, "segment_epoch": 1791223740, "covers_from": "2026-10-05T18:09:00+00:00", "covers_to": "2026-10-05T18:10:00+00:00", "next_epoch": 1791223800, "schedule": [{"starts_at": "2026-10-05T18:09:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 2972, "sprite_key": "squirrel_business", "district": "xinyi", "topic": "交通", "content": "公車司機為了趕班次車都開很快、沒等人上車或是會急煞（明知前面有紅燈也硬要急煞），希望可以改善", "display_name": "信義代表 No.2,972", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-05T18:09:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 43947, "sprite_key": "giraffe_business", "district": "neihu", "topic": "其他", "content": "希望男廁所小便斗可以設置掛勾，這樣可以放置雨傘（可參照日本）；另外在捷運站口可以放置傘套使用，謝謝。", "display_name": "內湖代表 Mike", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-05T18:09:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 53922, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "天母國小周圍的環境越來越髒，落葉狗屎蟑螂越來越多，我曾經寫市長信箱，市府竟然將我的個資給清潔隊，惡劣", "display_name": "士林代表 No.53,922", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-05T18:09:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 5138, "sprite_key": "leopardcat_business", "district": "nangang", "topic": "環境", "content": "遛狗是養狗人最日常的事，希望公園周遭能設置垃圾桶方便丟屎（不然都會丟去公廁垃圾桶）", "display_name": "南港代表 陳萱", "mood": "hopeful", "is_replay": true}], "queue": [{"position": 1, "queue_number": 43947, "sprite_key": "giraffe_business", "display_name": "內湖代表 Mike", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 53922, "sprite_key": "leopardcat_suburb", "display_name": "士林代表 No.53,922", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 5138, "sprite_key": "leopardcat_business", "display_name": "南港代表 陳萱", "district": "nangang", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 21456, "sprite_key": "turtle_business", "display_na