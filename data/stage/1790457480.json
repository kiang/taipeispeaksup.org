{"schema_version": 1, "segment_epoch": 1790457480, "covers_from": "2026-09-26T21:18:00+00:00", "covers_to": "2026-09-26T21:19:00+00:00", "next_epoch": 1790457540, "schedule": [{"starts_at": "2026-09-26T21:18:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 29116, "sprite_key": "penguin_culture", "district": "daan", "topic": "教育", "content": "學校營養午餐要健康安全又好吃，自然就不會剩太多廚餘，教育局還要老師與學生將廚餘秤重量做記錄，本末倒置", "display_name": "大安代表 No.29,116", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-26T21:18:15+00:00", "duration_seconds": 8, "type": "padding", "queue_number": 24660, "sprite_key": "turtle_oldtown", "district": "datong", "topic": "長照", "content": "有沒有地方可以給老人家住因為不想造成小孩子的負擔", "display_name": "大同代表 No.24,660", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-26T21:18:23+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 7469, "sprite_key": "turtle_suburb", "district": "beitou", "topic": "長照", "content": "長輩太多 小孩太少沒辦法邊工作邊照顧 而且物價一直上漲 也請不起外傭 怎麼辦", "display_name": "北投代表 No.7,469", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-26T21:18:35+00:00", "duration_seconds": 8, "type": "padding", "queue_number": 280, "sprite_key": "turtle_business", "district": "neihu", "topic": "長照", "content": "居服員假日輔助多一點\n困難加給請不要再砍了", "display_name": "內湖代表 No.280", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-26T21:18:43+00:00", "duration_seconds": 17, "type": "padding", "queue_number": 17992, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "人行道上幾個盆栽圍起來就成了吸煙區，路過的行人都要要吸二手菸，這種狗皮膏藥式的設施我們不要", "display_name": "大安代表 No.17,992", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 24660, "sprite_key": "turtle_oldtown", "display_name": "大同代表 No.24,660", "district": "datong", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 7469, "sprite_key": "turtle_suburb", "display_name": "北投代表 No.7,469", "district": "beitou", "is_replay": true, "frozen": tru