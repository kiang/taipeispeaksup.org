{"schema_version": 1, "segment_epoch": 1790655120, "covers_from": "2026-09-29T04:12:00+00:00", "covers_to": "2026-09-29T04:13:00+00:00", "next_epoch": 1790655180, "schedule": [{"starts_at": "2026-09-29T04:12:00+00:00", "duration_seconds": 15, "queue_number": 53302, "sprite_key": "squirrel_business", "district": "xinyi", "topic": "交通", "content": "期盼沈市長能讓台北交通順暢\n對所有用路人都友善\n而不是行人萬歲.無敵\n近一年來光禮讓行人我吃過罰單", "display_name": "信義代表 No.53,302", "mood": "angry", "is_replay": false}, {"starts_at": "2026-09-29T04:12:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 18410, "sprite_key": "beaver_suburb", "district": "wenshan", "topic": "公共安全", "content": "文山區社區去年10月大雨，社區邊坡土石流。市府改善工程常常做一天休好幾天，到現在還在施工，何時會好？", "display_name": "文山代表 No.18,410", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-29T04:12:30+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 46167, "sprite_key": "elephant_oldtown", "district": "zhongzheng", "topic": "市政", "content": "台北市的房價太貴，社宅又很少，要在台北居真的大不易。希望未來的市長也能重視居住議題。", "display_name": "中正代表 No.46,167", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-29T04:12:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 33301, "sprite_key": "squirrel_oldtown", "district": "zhongzheng", "topic": "交通", "content": "長輩說搭公車很危險，司機開太快，常有長者摔斷腿，司機說排班太滿太緊所以開快車，多招幾個司機就解決問題", "display_name": "中正代表 老周", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 18410, "sprite_key": "beaver_suburb", "display_name": "文山代表 No.18,410", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 46167, "sprite_key": "elephant_oldtown", "display_name": "中正代表 No.46,167", "district": "zhongzheng", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 33301, "sprite_key": "squirrel_oldtown", "display_name": "中正代表 老周", "district": "zhongzheng", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 51853, "sprite_key": "deer_suburb", "displ