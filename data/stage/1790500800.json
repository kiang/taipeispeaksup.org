{"schema_version": 1, "segment_epoch": 1790500800, "covers_from": "2026-09-27T09:20:00+00:00", "covers_to": "2026-09-27T09:21:00+00:00", "next_epoch": 1790500860, "schedule": [{"starts_at": "2026-09-27T09:20:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 27584, "sprite_key": "beaver_culture", "district": "zhongshan", "topic": "城市修繕", "content": "我知道夜間施工無法避免，但這幾年施工連公告都沒有，打去1999甚至說沒登記？隔天丟一句沒看到就結案？", "display_name": "中山代表 No.27,584", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-27T09:20:15+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 14126, "sprite_key": "giraffe_suburb", "district": "shilin", "topic": "其他", "content": "未來的市長你好，我希望能恢復被柯文哲廢掉的老人津貼！這是以前陳水扁的政策，造福我們老人！", "display_name": "士林代表 No.14,126", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-09-27T09:20:29+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 24626, "sprite_key": "leopardcat_suburb", "district": "beitou", "topic": "環境", "content": "水溝消毒完很可怕，騎樓都變蟑螂路，雖然我不怕蟑螂，但滿地都是真的蠻噁的。高雄人在高雄沒遇過這場景。", "display_name": "北投代表 Amy", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-27T09:20:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 33632, "sprite_key": "beaver_culture", "district": "daan", "topic": "城市修繕", "content": "幸安國小前的噴水池幾十年了，為什麼去年要突然修繕，還貼滿古時候廁所用的白瓷磚…醜死了！！", "display_name": "大安代表 No.33,632", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 14126, "sprite_key": "giraffe_suburb", "display_name": "士林代表 No.14,126", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 24626, "sprite_key": "leopardcat_suburb", "display_name": "北投代表 Amy", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 33632, "sprite_key": "beaver_culture", "display_name": "大安代表 No.33,632", "district": "daan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 52521, "sprite_key": "bear_oldtown", "display_na