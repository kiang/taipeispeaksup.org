{"schema_version": 1, "segment_epoch": 1790485560, "covers_from": "2026-09-27T05:06:00+00:00", "covers_to": "2026-09-27T05:07:00+00:00", "next_epoch": 1790485620, "schedule": [{"starts_at": "2026-09-27T05:06:00+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 41503, "sprite_key": "bear_business", "district": "nangang", "topic": "勞工", "content": "如何做到彈性工時，還有育兒環境如何踏實？", "display_name": "南港代表 No.41,503", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-09-27T05:06:06+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 1171, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "我住中山區 常常經過不少狹窄的巷弄 不但垃圾雜物堆滿 也常有不少流浪動物徘徊 噪音和油煙污染承受不住", "display_name": "中山代表 No.1,171", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-27T05:06:21+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 44817, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "台北夏天的晚上，街道上總是會有許多蟑螂…\n不知道是不是有解方？減少蟑螂+改善環境", "display_name": "大安代表 I Jung Lin", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-09-27T05:06:33+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 13126, "sprite_key": "leopardcat_oldtown", "district": "zhongzheng", "topic": "環境", "content": "為什麽台北人行道那麼髒亂", "display_name": "中正代表 No.13,126", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-27T05:06:38+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 19299, "sprite_key": "penguin_culture", "district": "zhongshan", "topic": "育兒", "content": "兒虐問題需要好好處理，不安置處於風險中的兒童是很糟糕失職的", "display_name": "中山代表 No.19,299", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-27T05:06:47+00:00", "duration_seconds": 13, "type": "padding", "queue_number": 47608, "sprite_key": "turtle_culture", "district": "daan", "topic": "醫療", "content": "提高醫護所得限制，把外配依親那些浪費健保資源停掉", "display_name": "大安代表 No.47,608", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number":