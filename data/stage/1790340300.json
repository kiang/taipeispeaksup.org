{"schema_version": 1, "segment_epoch": 1790340300, "covers_from": "2026-09-25T12:45:00+00:00", "covers_to": "2026-09-25T12:46:00+00:00", "next_epoch": 1790340360, "schedule": [{"starts_at": "2026-09-25T12:45:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 42868, "sprite_key": "penguin_culture", "district": "songshan", "topic": "教育", "content": "台北市除了新建的圖書館外，很多小型社區圖書館環境空間資源老舊，希望沈伯洋市長能好好做八年改善這個問題", "display_name": "松山代表 No.42,868", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-25T12:45:15+00:00", "duration_seconds": 8, "type": "padding", "queue_number": 20128, "sprite_key": "leopardcat_culture", "district": "songshan", "topic": "環境", "content": "有老人在行道樹的樹幹上按熄煙蒂然後把煙丟到花圃裡", "display_name": "松山代表 No.20,128", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-25T12:45:23+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 26979, "sprite_key": "deer_business", "district": "neihu", "topic": "觀光", "content": "風櫃嘴的公車路線只有一條 能不能從內湖大湖公園這邊也可以上一台 汐止那邊也上一條", "display_name": "內湖代表 Jack(堉倫，芯妍)", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-25T12:45:35+00:00", "duration_seconds": 8, "type": "padding", "queue_number": 49220, "sprite_key": "squirrel_oldtown", "district": "zhongzheng", "topic": "交通", "content": "讓捷運站能播放輕音樂 讓市民搭車都能享受放鬆", "display_name": "中正代表 No.49,220", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-25T12:45:43+00:00", "duration_seconds": 17, "type": "padding", "queue_number": 51189, "sprite_key": "penguin_suburb", "district": "wenshan", "topic": "教育", "content": "看有人說營養午餐水果只有藍莓3顆 但我想說 營養午餐免費後 政大附中連水果都沒有耶", "display_name": "文山代表 No.51,189", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 20128, "sprite_key": "leopardcat_culture", "display_name": "松山代表 No.20,128", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 26979, "sprite_key": "deer_business", "display_name": "內湖代表 Jack(堉倫，芯妍)", "district": "neihu", "is