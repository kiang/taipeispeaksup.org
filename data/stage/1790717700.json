{"schema_version": 1, "segment_epoch": 1790717700, "covers_from": "2026-09-29T21:35:00+00:00", "covers_to": "2026-09-29T21:36:00+00:00", "next_epoch": 1790717760, "schedule": [{"starts_at": "2026-09-29T21:35:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 42489, "sprite_key": "deer_business", "district": "nangang", "topic": "觀光", "content": "看完東，帶我走演唱會的影片，請問台北市能辦出類似的演唱會嗎？畢竟台北市的場地跟預算絕對比台東多……", "display_name": "南港代表 No.42,489", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-29T21:35:15+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 23945, "sprite_key": "leopardcat_suburb", "district": "wenshan", "topic": "環境", "content": "騎樓垃圾變多了，樹砍太多了。", "display_name": "文山代表 No.23,945", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-29T21:35:20+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 45138, "sprite_key": "leopardcat_suburb", "district": "wenshan", "topic": "環境", "content": "台北市以前很乾淨，每早上都有清潔人員認真掃街，現在都沒有，到處都是垃圾。還我每條街都有認真清潔隊員", "display_name": "文山代表 No.45,138", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-29T21:35:35+00:00", "duration_seconds": 25, "type": "padding", "queue_number": 19313, "sprite_key": "leopardcat_business", "district": "nangang", "topic": "環境", "content": "不要再砍樹，城市綠化需有全面及長期規劃\n禁煙區域應該擴大，而不是方便吸煙者", "display_name": "南港代表 No.19,313", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 23945, "sprite_key": "leopardcat_suburb", "display_name": "文山代表 No.23,945", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 45138, "sprite_key": "leopardcat_suburb", "display_name": "文山代表 No.45,138", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 19313, "sprite_key": "leopardcat_business", "display_name": "南港代表 No.19,313", "district": "nangang", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 44529, "sprite_key": "beaver_culture", "display_name": "松山