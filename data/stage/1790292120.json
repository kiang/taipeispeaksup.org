{"schema_version": 1, "segment_epoch": 1790292120, "covers_from": "2026-09-24T23:22:00+00:00", "covers_to": "2026-09-24T23:23:00+00:00", "next_epoch": 1790292180, "schedule": [{"starts_at": "2026-09-24T23:22:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 45238, "sprite_key": "beaver_culture", "district": "zhongshan", "topic": "城市修繕", "content": "市長你好\n我是一個職業媽媽，日常騎車載小孩上下學，台北市的路，顛簸的比平坦的多，請問市長怎麼看？", "display_name": "中山代表 No.45,238", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-24T23:22:15+00:00", "duration_seconds": 8, "type": "padding", "queue_number": 16082, "sprite_key": "squirrel_suburb", "district": "wenshan", "topic": "交通", "content": "人行道設計管理得爛，行人當然走到馬路上，危險至極！", "display_name": "文山代表 No.16,082", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-24T23:22:23+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 21281, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "在澳洲雪梨生活的幾年幾乎沒有吸到二手菸，在台北每次走在路上100%會吸到二手菸，禁菸區吸菸也無人取締", "display_name": "大安代表 No.21,281", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-24T23:22:38+00:00", "duration_seconds": 22, "type": "padding", "queue_number": 34141, "sprite_key": "elephant_oldtown", "district": "wanhua", "topic": "治安", "content": "多處住宅區，都有麻將館設立，有的也鄰近學校，人員複雜，隨地吸煙亂丟煙蒂，管理鬆散，造成治安及環境問題", "display_name": "萬華代表 No.34,141", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 16082, "sprite_key": "squirrel_suburb", "display_name": "文山代表 No.16,082", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 21281, "sprite_key": "leopardcat_culture", "display_name": "大安代表 No.21,281", "district": "daan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 34141, "sprite_key": "elephant_oldtown", "display_name": "萬華代表 No.34,141", "district": "wanhua", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 18508, "sprite_key": "squirrel_oldtown", "dis