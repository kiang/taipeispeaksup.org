{"schema_version": 1, "segment_epoch": 1790725920, "covers_from": "2026-09-29T23:52:00+00:00", "covers_to": "2026-09-29T23:53:00+00:00", "next_epoch": 1790725980, "schedule": [{"starts_at": "2026-09-29T23:52:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 32504, "sprite_key": "beaver_business", "district": "neihu", "topic": "城市修繕", "content": "我們住在內湖的東湖，是一百戶的老舊社區，屋齡五十年，公寓已有傾斜、鋼筋外露…住戶協調都更無疾…怎麼辦", "display_name": "內湖代表 No.32,504", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-29T23:52:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 22785, "sprite_key": "squirrel_suburb", "district": "shilin", "topic": "交通", "content": "家中長輩坐公車時，常遇到司機沒有把地盤降低，老人家上下車很辛苦，期盼市長能夠讓台北的公車對長輩更友善", "display_name": "士林代表 No.22,785", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-29T23:52:30+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 33609, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "希望機車停車位多一點", "display_name": "大安代表 No.33,609", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-29T23:52:35+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 13378, "sprite_key": "penguin_suburb", "district": "wenshan", "topic": "育兒", "content": "要有照顧孩子後援", "display_name": "文山代表 No.13,378", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-29T23:52:40+00:00", "duration_seconds": 20, "type": "padding", "queue_number": 24342, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "我走路上班，附近大樓的退縮人行道上會有準備上班的人聚集抽菸，我不能走人行道還要閃避，想要無菸環境", "display_name": "中山代表 No.24,342", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 22785, "sprite_key": "squirrel_suburb", "display_name": "士林代表 No.22,785", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 33609, "sprite_key": "squirrel_culture", "display_name": "大安代表 No.33,609", "district": "daan", "is_replay": true, "f