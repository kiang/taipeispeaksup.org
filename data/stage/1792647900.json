{"schema_version": 1, "segment_epoch": 1792647900, "covers_from": "2026-10-22T05:45:00+00:00", "covers_to": "2026-10-22T05:46:00+00:00", "next_epoch": 1792647960, "schedule": [{"starts_at": "2026-10-22T05:45:00+00:00", "duration_seconds": 15, "queue_number": 69011, "sprite_key": "squirrel_culture", "district": "zhongshan", "topic": "交通", "content": "市長市長～我很常去台北市出差或看演唱會，每次在台北車站總是會迷路團團轉@@ 尤其是地下街超級複雜", "display_name": "中山代表 No.69,011", "mood": "helpless", "is_replay": false}, {"starts_at": "2026-10-22T05:45:15+00:00", "duration_seconds": 14, "queue_number": 69012, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "我對台北市政府砍伐市區的樹木深惡痛絕，樹木可以生病但是我們也有樹木醫生，或是栽種新的樹木。", "display_name": "中山代表 No.69,012", "mood": "angry", "is_replay": false}, {"starts_at": "2026-10-22T05:45:29+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 38475, "sprite_key": "squirrel_suburb", "district": "shilin", "topic": "交通", "content": "我認為現今的公車站牌路線標示對於外國遊客來說十分混雜，如要去捷運站，不知道去那個方向的公車站", "display_name": "士林代表 No.38,475", "mood": "hopeful", "is_replay": true}, {"starts_at": "2026-10-22T05:45:44+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 6052, "sprite_key": "turtle_suburb", "district": "wenshan", "topic": "長照", "content": "怎麼安排人力", "display_name": "文山代表 No.6,052", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-22T05:45:49+00:00", "duration_seconds": 11, "type": "padding", "queue_number": 59104, "sprite_key": "penguin_business", "district": "neihu", "topic": "育兒", "content": "希望有更多公托", "display_name": "內湖代表 徐志雄(予樂爸)", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 69012, "sprite_key": "leopardcat_culture", "display_name": "中山代表 No.69,012", "district": "zhongshan", "is_replay": false, "frozen": true}, {"position": 2, "queue_number": 38475, "sprite_key": "squirrel_suburb", "display_name": "士林代表 No.38,475", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 3, "queu