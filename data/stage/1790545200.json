{"schema_version": 1, "segment_epoch": 1790545200, "covers_from": "2026-09-27T21:40:00+00:00", "covers_to": "2026-09-27T21:41:00+00:00", "next_epoch": 1790545260, "schedule": [{"starts_at": "2026-09-27T21:40:00+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 9491, "sprite_key": "squirrel_culture", "district": "songshan", "topic": "交通", "content": "機車停車格一直在減少，逐漸被改劃紅線，要合法停車都要花很多時間找位置，很困擾", "display_name": "松山代表 No.9,491", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-27T21:40:12+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 11981, "sprite_key": "beaver_culture", "district": "zhongshan", "topic": "城市修繕", "content": "市長您好，我是在台北市中山站髮廊上班的新北市民，覺得台北市的市容很醜，希望市長將來上任能夠改善，謝謝", "display_name": "中山代表 No.11,981", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-27T21:40:27+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 46402, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "去健身房的路是林森北路從民族到長春。沿途上任何時段永遠有躲不完的二手煙味。明明要健身身體都不好了。", "display_name": "中山代表 No.46,402", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-27T21:40:42+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 43694, "sprite_key": "penguin_business", "district": "xinyi", "topic": "其他", "content": "邊走邊抽菸很討人厭，路人被迫吸二手菸。所以邊走邊抽煙要禁止。", "display_name": "信義代表 No.43,694", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-27T21:40:51+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 35294, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "不要亂砍樹木, 不要隨便修剪樹木、要有遮蔭美觀樹木", "display_name": "士林代表 No.35,294", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 11981, "sprite_key": "beaver_culture", "display_name": "中山代表 No.11,981", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 46402, "sprite_key": "leopardcat_culture", "display_name": "中山代表 No.46,402", "distr