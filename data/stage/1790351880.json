{"schema_version": 1, "segment_epoch": 1790351880, "covers_from": "2026-09-25T15:58:00+00:00", "covers_to": "2026-09-25T15:59:00+00:00", "next_epoch": 1790351940, "schedule": [{"starts_at": "2026-09-25T15:58:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 34129, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "自從陳水扁以後，我幾乎沒看過台北尖峰時間塞這樣，倒底出了什麼事？無論晴雨週末通通都塞。請改善！", "display_name": "大安代表 Naiyuan Lin", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-25T15:58:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 51476, "sprite_key": "deer_suburb", "district": "shilin", "topic": "體育", "content": "劍潭三腳渡堤防不方便長輩騎腳踏車進入河濱腳踏車道運動，因為都要爬坡越堤，希望可以評估做水門進出，謝謝", "display_name": "士林代表 No.51,476", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-25T15:58:30+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 42250, "sprite_key": "squirrel_culture", "district": "zhongshan", "topic": "交通", "content": "為何很多地方明明就有人行道卻還要在馬路上加畫人行道？限縮了車流量也增加車禍及塞車的機率。", "display_name": "中山代表 No.42,250", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-25T15:58:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 32992, "sprite_key": "turtle_suburb", "district": "beitou", "topic": "食安", "content": "我願意付餐費讓我的孩子吃得更好更健康！", "display_name": "北投代表 No.32,992", "mood": "caring", "is_replay": true}], "queue": [{"position": 1, "queue_number": 51476, "sprite_key": "deer_suburb", "display_name": "士林代表 No.51,476", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 42250, "sprite_key": "squirrel_culture", "display_name": "中山代表 No.42,250", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 32992, "sprite_key": "turtle_suburb", "display_name": "北投代表 No.32,992", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 43338, "sprite_key": "turtle_culture", "display_name": "大安代表 No.43,338