{"schema_version": 1, "segment_epoch": 1790912280, "covers_from": "2026-10-02T03:38:00+00:00", "covers_to": "2026-10-02T03:39:00+00:00", "next_epoch": 1790912340, "schedule": [{"starts_at": "2026-10-02T03:38:00+00:00", "duration_seconds": 15, "queue_number": 55286, "sprite_key": "penguin_suburb", "district": "shilin", "topic": "教育", "content": "午餐保留自費加價的彈性，那沒有辦法加價的同學是要另外分開吃嗎？這樣不會造成經濟階級差異更明顯嗎？", "display_name": "士林代表 No.55,286", "mood": "worried", "is_replay": false}, {"starts_at": "2026-10-02T03:38:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 37228, "sprite_key": "penguin_business", "district": "neihu", "topic": "教育", "content": "我孩子就讀碧湖國小和麗山國中，學期開始抱怨桶餐不僅菜色變差很多，甚至肉絲青菜湯的都只有兩根，真的很糟", "display_name": "內湖代表 No.37,228", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-02T03:38:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 54628, "sprite_key": "squirrel_culture", "district": "zhongshan", "topic": "交通", "content": "公有的停車場都有2-5個樓梯，但是卻不是每一座樓梯都有至少一個繳費機，這樣不是很麻煩的一件事嗎？", "display_name": "中山代表 No.54,628", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-02T03:38:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 36714, "sprite_key": "squirrel_suburb", "district": "beitou", "topic": "交通", "content": "北投市場外攤區是否在上午某段時間暫時變成徒步區，買菜還一直要閃避衝來衝去的機車很傷腦筋", "display_name": "北投代表 No.36,714", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 37228, "sprite_key": "penguin_business", "display_name": "內湖代表 No.37,228", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 54628, "sprite_key": "squirrel_culture", "display_name": "中山代表 No.54,628", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 36714, "sprite_key": "squirrel_suburb", "display_name": "北投代表 No.36,714", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 21564, "sprite_key": "deer_suburb", "display_n