{"schema_version": 1, "segment_epoch": 1792148760, "covers_from": "2026-10-16T11:06:00+00:00", "covers_to": "2026-10-16T11:07:00+00:00", "next_epoch": 1792148820, "schedule": [{"starts_at": "2026-10-16T11:06:00+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 65042, "sprite_key": "deer_oldtown", "district": "wanhua", "topic": "觀光", "content": "我是台南人\n去台北很多次了\n每次坐捷運手扶梯總是有人要在梯上左側快速走動，希望規定不能走動", "display_name": "萬華代表 楊阿泓", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-16T11:06:14+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 49996, "sprite_key": "squirrel_suburb", "district": "shilin", "topic": "交通", "content": "社正路（平面停車場旁）和延平北路六段交叉口可設紅綠燈，因為行人過馬路時很危險，松山區小巷子都有紅綠燈", "display_name": "士林代表 No.49,996", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-16T11:06:29+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 10561, "sprite_key": "leopardcat_business", "district": "xinyi", "topic": "環境", "content": "市政府遠百A13、貴婦百貨人行道每天一堆人抽煙，造成行人不想聞也得聞，多數行人反而在忍受少數抽菸人士", "display_name": "信義代表 No.10,561", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-16T11:06:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 24912, "sprite_key": "penguin_culture", "district": "zhongshan", "topic": "其他", "content": "希望台北可以有更多平價一點的社宅，不需要到10幾坪，救救年輕人。", "display_name": "中山代表 No.24,912", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 49996, "sprite_key": "squirrel_suburb", "display_name": "士林代表 No.49,996", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 10561, "sprite_key": "leopardcat_business", "display_name": "信義代表 No.10,561", "district": "xinyi", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 24912, "sprite_key": "penguin_culture", "display_name": "中山代表 No.24,912", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 44243, "sprite_key": "leopardcat_culture