{"schema_version": 1, "segment_epoch": 1792140600, "covers_from": "2026-10-16T08:50:00+00:00", "covers_to": "2026-10-16T08:51:00+00:00", "next_epoch": 1792140660, "schedule": [{"starts_at": "2026-10-16T08:50:00+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 3043, "sprite_key": "squirrel_suburb", "district": "wenshan", "topic": "交通", "content": "文山區木柵國小這區域附近，路非常小條，附近都是高樓，很塞車。人行道也是很小，推車族很難行動", "display_name": "文山代表 No.3,043", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-16T08:50:14+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 55626, "sprite_key": "giraffe_business", "district": "nangang", "topic": "其他", "content": "希望台北能成為禁止寵物（例如貓狗為大宗）繁殖買賣的示範區，減少動物被利用來繁殖的痛苦，領養代替購買。", "display_name": "南港代表 No.55,626", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-16T08:50:29+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 58734, "sprite_key": "turtle_suburb", "district": "wenshan", "topic": "其他", "content": "蔣說政治人物要誠實面對以前的自己，請他誠實面對為何踫風美國學經歷？英文為何這麼差？為何不驗DNA?", "display_name": "文山代表 No.58,734", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-16T08:50:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 18620, "sprite_key": "penguin_suburb", "district": "beitou", "topic": "育兒", "content": "推小孩走在路上，人行道有機車停沒辦法走，所以走進去騎樓，也有機車在騎，那我們要走哪裡呢？育兒好不友善", "display_name": "北投代表 No.18,620", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 55626, "sprite_key": "giraffe_business", "display_name": "南港代表 No.55,626", "district": "nangang", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 58734, "sprite_key": "turtle_suburb", "display_name": "文山代表 No.58,734", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 18620, "sprite_key": "penguin_suburb", "display_name": "北投代表 No.18,620", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 3428, "sprite_key": "squirrel_