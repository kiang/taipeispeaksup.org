{"schema_version": 1, "segment_epoch": 1792453560, "covers_from": "2026-10-19T23:46:00+00:00", "covers_to": "2026-10-19T23:47:00+00:00", "next_epoch": 1792453620, "schedule": [{"starts_at": "2026-10-19T23:46:00+00:00", "duration_seconds": 15, "queue_number": 67878, "sprite_key": "leopardcat_oldtown", "district": "datong", "topic": "環境", "content": "淡水河、基隆河、新店溪，每一條會流進台北市的大河小溪都要進一步整治，要可以像高雄愛河一樣小船觀光。", "display_name": "大同代表 No.67,878", "mood": "hopeful", "is_replay": false}, {"starts_at": "2026-10-19T23:46:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 25745, "sprite_key": "penguin_oldtown", "district": "datong", "topic": "育兒", "content": "兒虐不斷，營養午餐品質低落，身為台北的家長真的很無奈，難道不是權貴的我們真的就如蔣市長口中爛命一條！", "display_name": "大同代表 No.25,745", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-19T23:46:30+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 3485, "sprite_key": "squirrel_culture", "district": "zhongshan", "topic": "交通", "content": "希望行人跟車子的號誌燈統一分開，因為有走很慢的行人跟不願意讓的車子，分開比較不會互相拖累", "display_name": "中山代表 No.3,485", "mood": "hopeful", "is_replay": true}, {"starts_at": "2026-10-19T23:46:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 18719, "sprite_key": "penguin_culture", "district": "zhongshan", "topic": "其他", "content": "我戶籍仍在台北市，但大部分時間都在高雄。這幾年高雄市大幅進步，請問，作為首都的台北市是否能迎頭趕上？", "display_name": "中山代表 No.18,719", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 25745, "sprite_key": "penguin_oldtown", "display_name": "大同代表 No.25,745", "district": "datong", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 3485, "sprite_key": "squirrel_culture", "display_name": "中山代表 No.3,485", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 18719, "sprite_key": "penguin_culture", "display_name": "中山代表 No.18,719", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 67879, "sprite_key": "penguin_busi