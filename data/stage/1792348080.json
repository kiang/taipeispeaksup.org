{"schema_version": 1, "segment_epoch": 1792348080, "covers_from": "2026-10-18T18:28:00+00:00", "covers_to": "2026-10-18T18:29:00+00:00", "next_epoch": 1792348140, "schedule": [{"starts_at": "2026-10-18T18:28:00+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 48071, "sprite_key": "leopardcat_oldtown", "district": "datong", "topic": "環境", "content": "永樂市場是個有文化的地方，但環境有點味道，也沒垃圾桶，垃圾都丟廁所…真的不行啊！", "display_name": "大同代表 No.48,071", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-18T18:28:12+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 28152, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "汐止民生線等了好多年 結果台北市一句沒錢就只能蓋到東湖 這對汐止人一點都不方便", "display_name": "內湖代表 No.28,152", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-18T18:28:24+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 63125, "sprite_key": "squirrel_business", "district": "xinyi", "topic": "交通", "content": "雙十晚上九時許坐藍5，司機提醒下車動作快，因為九點半要發車，在挹翠山路上飆車真的危險，但我同理他辛苦", "display_name": "信義代表 No.63,125", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-18T18:28:39+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 13189, "sprite_key": "leopardcat_oldtown", "district": "zhongzheng", "topic": "環境", "content": "每次經過台北車站都會看到花圃有很多老鼠！可怕的是老鼠不怕我！是我怕老鼠😓😓", "display_name": "中正代表 No.13,189", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-18T18:28:51+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 30072, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "請市長一定要把樹種回來", "display_name": "中山代表 No.30,072", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 28152, "sprite_key": "squirrel_business", "display_name": "內湖代表 No.28,152", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 63125, "sprite_key": "squirrel_business", "display_name": "信義代表 No.63,125", "district": "