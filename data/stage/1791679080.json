{"schema_version": 1, "segment_epoch": 1791679080, "covers_from": "2026-10-11T00:38:00+00:00", "covers_to": "2026-10-11T00:39:00+00:00", "next_epoch": 1791679140, "schedule": [{"starts_at": "2026-10-11T00:38:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 39116, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "荷蘭家樹上有胖胖斑尾林鴿來築巢生蛋育雛，台北卻一直砍樹。兒子說台灣的鴿子們看起來好瘦，很可憐的感覺。", "display_name": "中山代表 Cheng Mei", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-11T00:38:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 11236, "sprite_key": "leopardcat_culture", "district": "songshan", "topic": "環境", "content": "我看到蔣萬安一直莫名其妙在砍樹就生氣，我要生活在綠色城市，我要台北的馬路因為有很多樹而很漂亮！", "display_name": "松山代表 Kate Huang", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-11T00:38:30+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 13321, "sprite_key": "leopardcat_culture", "district": "songshan", "topic": "環境", "content": "市容差，輸爛高雄，都沒看到有什麼進步", "display_name": "松山代表 No.13,321", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-11T00:38:36+00:00", "duration_seconds": 11, "type": "padding", "queue_number": 14236, "sprite_key": "penguin_culture", "district": "daan", "topic": "其他", "content": "覺得現任市長做的不好#*&\n且耍特權\n也希望能趕快換小沈市長,來做！！", "display_name": "大安代表 No.14,236", "mood": "hopeful", "is_replay": true}, {"starts_at": "2026-10-11T00:38:47+00:00", "duration_seconds": 13, "type": "padding", "queue_number": 15290, "sprite_key": "beaver_business", "district": "xinyi", "topic": "公共安全", "content": "把前市長胡搞的東西通通恢復原狀！！！欸……會不會太強人所難？", "display_name": "信義代表 No.15,290", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 11236, "sprite_key": "leopardcat_culture", "display_name": "松山代表 Kate Huang", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 13321, "sprite_key": "leopardcat_culture", "display_name": "松山代表 No.13,321", "d