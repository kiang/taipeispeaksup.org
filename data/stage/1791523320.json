{"schema_version": 1, "segment_epoch": 1791523320, "covers_from": "2026-10-09T05:22:00+00:00", "covers_to": "2026-10-09T05:23:00+00:00", "next_epoch": 1791523380, "schedule": [{"starts_at": "2026-10-09T05:22:00+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 27321, "sprite_key": "leopardcat_business", "district": "xinyi", "topic": "環境", "content": "為什麼公園旁都沒有垃圾桶， 要不就是把垃圾桶設在很隱密的地方？有必要這樣嗎？", "display_name": "信義代表 No.27,321", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-09T05:22:12+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 16171, "sprite_key": "squirrel_culture", "district": "songshan", "topic": "交通", "content": "馬路車道分格線在下雨天的晚上無法看清楚，是使用材料的問題嗎？", "display_name": "松山代表 No.16,171", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-09T05:22:21+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 20794, "sprite_key": "deer_oldtown", "district": "wanhua", "topic": "文化", "content": "不要再一天到晚只引進中國的文化交流\n台北不是中國城好嗎", "display_name": "萬華代表 Marsbar", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-09T05:22:30+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 39360, "sprite_key": "beaver_culture", "district": "daan", "topic": "城市修繕", "content": "台北太醜了，希望可以變美。但變美並不是刻意蓋什麼設施，而是拿掉醜陋的東西。", "display_name": "大安代表 左星星", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-09T05:22:42+00:00", "duration_seconds": 18, "type": "padding", "queue_number": 23597, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "內湖成功路四段和五段公車過多，路線重複。上下班時間常是5-6台以上連續的公車蜈蚣，每站距太短位置不良", "display_name": "內湖代表 Richard", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 16171, "sprite_key": "squirrel_culture", "display_name": "松山代表 No.16,171", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 20794, "sprite_key": "deer_oldtown", "display_name": "萬華代表 Marsbar", "district": "wanhua", "is_replay": true