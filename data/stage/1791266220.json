{"schema_version": 1, "segment_epoch": 1791266220, "covers_from": "2026-10-06T05:57:00+00:00", "covers_to": "2026-10-06T05:58:00+00:00", "next_epoch": 1791266280, "schedule": [{"starts_at": "2026-10-06T05:57:00+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 31836, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "星期二跟朋友去士林捷運站附近吃飯 在走路的過程中 花叢裡面突然跳出3 4隻老鼠 真的很可怕", "display_name": "士林代表 No.31,836", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-06T05:57:14+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 16959, "sprite_key": "leopardcat_business", "district": "xinyi", "topic": "環境", "content": "我在信義區忠孝東路五段這裡，這兩個月明顯老鼠變多了，還會跑到3-4樓的陽台，現在沙門跟玻璃門都要關好", "display_name": "信義代表 No.16,959", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-06T05:57:29+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 19581, "sprite_key": "beaver_oldtown", "district": "zhongzheng", "topic": "城市修繕", "content": "有好多老老老公寓 沒有電梯 老人家老了 居住上很不方便 有沒有都市更新政策可以讓公寓變成高齡者友善", "display_name": "中正代表 No.19,581", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-06T05:57:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 51667, "sprite_key": "beaver_culture", "district": "songshan", "topic": "城市修繕", "content": "都更開發商用話術,在未達門檻就叫人去選屋,問題市府不管這些,應該是市府收到同意過門,再全體舉辦選屋", "display_name": "松山代表 No.51,667", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 16959, "sprite_key": "leopardcat_business", "display_name": "信義代表 No.16,959", "district": "xinyi", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 19581, "sprite_key": "beaver_oldtown", "display_name": "中正代表 No.19,581", "district": "zhongzheng", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 51667, "sprite_key": "beaver_culture", "display_name": "松山代表 No.51,667", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 12210, "spr