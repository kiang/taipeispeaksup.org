{"schema_version": 1, "segment_epoch": 1790313120, "covers_from": "2026-09-25T05:12:00+00:00", "covers_to": "2026-09-25T05:13:00+00:00", "next_epoch": 1790313180, "schedule": [{"starts_at": "2026-09-25T05:12:00+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 29757, "sprite_key": "leopardcat_oldtown", "district": "zhongzheng", "topic": "環境", "content": "北車遊民問題，希望可以找到平衡\n目前幾年看起來都沒有太多成效\n讓台北門面大大扣分", "display_name": "中正代表 No.29,757", "mood": "hopeful", "is_replay": true}, {"starts_at": "2026-09-25T05:12:12+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 23904, "sprite_key": "beaver_business", "district": "xinyi", "topic": "城市修繕", "content": "市長，我是一個領隊，常常在各國國家旅行，我每次回到台北，都覺得台灣好醜！真的醜的要死！很沒建築美感", "display_name": "信義代表 トオジ🥸", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-25T05:12:27+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 49000, "sprite_key": "beaver_culture", "district": "daan", "topic": "城市修繕", "content": "住3容積率一定要大幅增加，一坪換一坪，臨馬路（美化市容）的七樓華廈應該優先", "display_name": "大安代表 No.49,000", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-09-25T05:12:39+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 50420, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "可以不要再砍樹了嗎？看到被砍，只剩下的樹根，它好痛，我也好心痛！ 請市長幫幫忙，我們愛樹，更愛台北！", "display_name": "中山代表 黃立怡", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-25T05:12:54+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 27224, "sprite_key": "turtle_culture", "district": "daan", "topic": "其他", "content": "幫我轉達何欣純說台中人也想要！", "display_name": "大安代表 No.27,224", "mood": "caring", "is_replay": true}], "queue": [{"position": 1, "queue_number": 23904, "sprite_key": "beaver_business", "display_name": "信義代表 トオジ🥸", "district": "xinyi", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 49000, "sprite_key": "beaver_culture", "display_name": "大安代表 No.49,000", "district": "daan", "is_re