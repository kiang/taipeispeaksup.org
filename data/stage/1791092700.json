{"schema_version": 1, "segment_epoch": 1791092700, "covers_from": "2026-10-04T05:45:00+00:00", "covers_to": "2026-10-04T05:46:00+00:00", "next_epoch": 1791092760, "schedule": [{"starts_at": "2026-10-04T05:45:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 29309, "sprite_key": "beaver_culture", "district": "zhongshan", "topic": "城市修繕", "content": "用拆垃圾桶來減少市府開銷，這種招術需要人類來當市長嗎？我拿著垃圾在台北市走了半天,一定要逼我亂丟嗎？", "display_name": "中山代表 No.29,309", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-04T05:45:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 27146, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "拜託把樹種回來，城市需要綠地，希望綠地覆蓋率提升，而且七百多萬無用大傘不要再裝了，我們根本不需要", "display_name": "大安代表 No.27,146", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-04T05:45:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 18684, "sprite_key": "squirrel_suburb", "district": "beitou", "topic": "交通", "content": "台北走騎樓萬萬不安，不是停滿機車就是變成營業或私人空間，跟警察反映就說去投訴啊，不投訴不處理被動王哦", "display_name": "北投代表 Ko Tsì-jîn", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-04T05:45:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 12275, "sprite_key": "leopardcat_suburb", "district": "beitou", "topic": "環境", "content": "常常看到道路在施工，但施工沒多久後道路又是坑坑巴巴，施工單位到底有受稽核審查嗎，有沒有偷工減料的問題", "display_name": "北投代表 No.12,275", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 27146, "sprite_key": "leopardcat_culture", "display_name": "大安代表 No.27,146", "district": "daan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 18684, "sprite_key": "squirrel_suburb", "display_name": "北投代表 Ko Tsì-jîn", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 12275, "sprite_key": "leopardcat_suburb", "display_name": "北投代表 No.12,275", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 56419, "sprit