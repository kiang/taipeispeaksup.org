{"schema_version": 1, "segment_epoch": 1790975280, "covers_from": "2026-10-02T21:08:00+00:00", "covers_to": "2026-10-02T21:09:00+00:00", "next_epoch": 1790975340, "schedule": [{"starts_at": "2026-10-02T21:08:00+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 44415, "sprite_key": "beaver_suburb", "district": "shilin", "topic": "城市修繕", "content": "台北許多招牌醜就算了，還有店家根本已經倒閉未拆除破損鐵架或冷氣鐵架，擺爛放著不處理市容超醜", "display_name": "士林代表 No.44,415", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-02T21:08:14+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 2358, "sprite_key": "leopardcat_business", "district": "neihu", "topic": "環境", "content": "台北市麻將館等場所日增，店外有人聚集吸菸，影響空氣品質並提高二手菸風險，公車站等人流密集處尤為嚴重。", "display_name": "內湖代表 戚居暘Ju-Yang Chi", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-02T21:08:29+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 42857, "sprite_key": "deer_oldtown", "district": "zhongzheng", "topic": "觀光", "content": "外國人問我說台北有什麼地方好玩。\n真的不知道回答什麼，只能說101，夜市。\n多介紹一下台北", "display_name": "中正代表 No.42,857", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-02T21:08:43+00:00", "duration_seconds": 17, "type": "padding", "queue_number": 35902, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "很多路邊店家都直接將廚餘廢水、或者是洗碗的廢水，直接倒入路邊的水溝，造成惡臭以及污水流入環境", "display_name": "中山代表 No.35,902", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 2358, "sprite_key": "leopardcat_business", "display_name": "內湖代表 戚居暘Ju-Yang Chi", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 42857, "sprite_key": "deer_oldtown", "display_name": "中正代表 No.42,857", "district": "zhongzheng", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 35902, "sprite_key": "leopardcat_culture", "display_name": "中山代表 No.35,902", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 55685, "spr