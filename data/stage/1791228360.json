{"schema_version": 1, "segment_epoch": 1791228360, "covers_from": "2026-10-05T19:26:00+00:00", "covers_to": "2026-10-05T19:27:00+00:00", "next_epoch": 1791228420, "schedule": [{"starts_at": "2026-10-05T19:26:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 46784, "sprite_key": "squirrel_suburb", "district": "beitou", "topic": "交通", "content": "老人行動較慢，上下車過馬路都需要較多的時間，請整個城市和交通配套，讓老人不用承受那麼多速度壓力", "display_name": "北投代表 No.46,784", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-05T19:26:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 5792, "sprite_key": "beaver_suburb", "district": "beitou", "topic": "城市修繕", "content": "我是北投區選民，當地有一些房子已經多年未修繕，甚至已經有居住安危，是否可以增加住宅都更頻率，落實安全", "display_name": "北投代表 Allen Hsu🦔", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-05T19:26:30+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 34503, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "交通往宜蘭方向堵塞，請問解方", "display_name": "內湖代表 No.34,503", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-05T19:26:35+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 2559, "sprite_key": "turtle_suburb", "district": "wenshan", "topic": "長照", "content": "台北市的老人太有活力了，可以讓他們變成勞動力嗎？不然在家沒有產值肌肉就流失，再來就臥床看醫生，不健康", "display_name": "文山代表 No.2,559", "mood": "positive", "is_replay": true}, {"starts_at": "2026-10-05T19:26:50+00:00", "duration_seconds": 10, "type": "padding", "queue_number": 13317, "sprite_key": "deer_suburb", "district": "beitou", "topic": "觀光", "content": "陽明山的下山公車太早就沒了。坐不到只能叫計程車🚕上山…", "display_name": "北投代表 No.13,317", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 5792, "sprite_key": "beaver_suburb", "display_name": "北投代表 Allen Hsu🦔", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 34503, "sprite_key": "squirrel_business", "display_name": "內湖代表 No.34,503", "district": "neihu", "is