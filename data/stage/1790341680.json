{"schema_version": 1, "segment_epoch": 1790341680, "covers_from": "2026-09-25T13:08:00+00:00", "covers_to": "2026-09-25T13:09:00+00:00", "next_epoch": 1790341740, "schedule": [{"starts_at": "2026-09-25T13:08:00+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 37689, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "台北公車都開很猛，坐在車上搖晃很大，煞車很急。很多老人都坐公車，每次都會擔心老人跌倒。", "display_name": "大安代表 No.37,689", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-25T13:08:14+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 40901, "sprite_key": "penguin_culture", "district": "zhongshan", "topic": "其他", "content": "希望每個社區有更多讓人休憩的社區空間、社區中心等等。", "display_name": "中山代表 No.40,901", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-25T13:08:23+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 25459, "sprite_key": "deer_suburb", "district": "wenshan", "topic": "文化", "content": "希望", "display_name": "文山代表 No.25,459", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-25T13:08:28+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 2639, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "增加垃圾桶、綠地、綠樹。盡量杜絕老鼠蟑螂與惡臭。我想要沈伯洋成為我們的市長！！", "display_name": "士林代表 No.2,639", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-25T13:08:40+00:00", "duration_seconds": 20, "type": "padding", "queue_number": 16172, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "公共垃圾桶太少，尤其是有的公園沒有垃圾桶。我遛狗的時候都會撿狗便，但是卻沒地方丟，帶在身上很臭很不便", "display_name": "士林代表 No.16,172", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 40901, "sprite_key": "penguin_culture", "display_name": "中山代表 No.40,901", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 25459, "sprite_key": "deer_suburb", "display_name": "文山代表 No.25,459", "district": "wenshan", "is_replay": true, "frozen"