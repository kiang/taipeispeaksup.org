{"schema_version": 1, "segment_epoch": 1792564740, "covers_from": "2026-10-21T06:39:00+00:00", "covers_to": "2026-10-21T06:40:00+00:00", "next_epoch": 1792564800, "schedule": [{"starts_at": "2026-10-21T06:39:00+00:00", "duration_seconds": 6, "queue_number": 68522, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "每個路口都畫上斑馬線和腳踏車道路增加安全", "display_name": "大安代表 No.68,522", "mood": "hopeful", "is_replay": false}, {"starts_at": "2026-10-21T06:39:06+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 6452, "sprite_key": "beaver_business", "district": "xinyi", "topic": "城市修繕", "content": "一般民眾收入無法購新屋搬遷，老屋沒電梯目前需過半住戶同意才裝電梯且費用高，老年人上下辛苦可有更好補助", "display_name": "信義代表 No.6,452", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-21T06:39:21+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 35420, "sprite_key": "deer_culture", "district": "zhongshan", "topic": "觀光", "content": "要怎麼讓外國人來觀光時喜歡上這個城市", "display_name": "中山代表 No.35,420", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-21T06:39:27+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 21716, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "台北市很多車道線都沒有對齊，常常開一開車道就不見了，這樣很容易產生碰撞跟糾紛", "display_name": "大安代表 No.21,716", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-21T06:39:39+00:00", "duration_seconds": 21, "type": "padding", "queue_number": 42393, "sprite_key": "beaver_culture", "district": "daan", "topic": "公共安全", "content": "希望移除路邊變電箱，除了破壞城市景觀，還很危險，我的朋友騎車滑倒頭部撞到變電箱，從此無法回復。", "display_name": "大安代表 No.42,393", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 6452, "sprite_key": "beaver_business", "display_name": "信義代表 No.6,452", "district": "xinyi", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 35420, "sprite_key": "deer_culture", "display_name": "中山代表 No.35,420", "district": "zhongshan", "is_replay": true, "frozen": true}, {"posi