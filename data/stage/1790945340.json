{"schema_version": 1, "segment_epoch": 1790945340, "covers_from": "2026-10-02T12:49:00+00:00", "covers_to": "2026-10-02T12:50:00+00:00", "next_epoch": 1790945400, "schedule": [{"starts_at": "2026-10-02T12:49:00+00:00", "duration_seconds": 12, "queue_number": 55541, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "台北市的垃圾桶越來越少、時常走遍大街小巷都找不到、可以還給市民垃圾桶嗎🥹", "display_name": "大安代表 No.55,541", "mood": "worried", "is_replay": false}, {"starts_at": "2026-10-02T12:49:12+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 2079, "sprite_key": "leopardcat_oldtown", "district": "wanhua", "topic": "環境", "content": "路邊假善心人士，一直發食物，人的食物，流浪動物的，無法可管嗎", "display_name": "萬華代表 No.2,079", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-02T12:49:21+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 55352, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "台北市紅線禁停我不反對，但臨時停車卸貨5分鐘警察大人就來開單，希望多設臨時停車位置或以時間來約束駕駛", "display_name": "大安代表 No.55,352", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-02T12:49:36+00:00", "duration_seconds": 24, "type": "padding", "queue_number": 30493, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "可請市長宣導公車司機參照日本公車禮儀，上下車等乘客坐好再啟動。重點是不要這麼愛急煞車，常常暈著下車。", "display_name": "內湖代表 No.30,493", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 2079, "sprite_key": "leopardcat_oldtown", "display_name": "萬華代表 No.2,079", "district": "wanhua", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 55352, "sprite_key": "squirrel_culture", "display_name": "大安代表 No.55,352", "district": "daan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 30493, "sprite_key": "squirrel_business", "display_name": "內湖代表 No.30,493", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 55542, "sprite_key": "turtle_culture", "display_name": "大安代表 No.55,542