{"schema_version": 1, "segment_epoch": 1790962080, "covers_from": "2026-10-02T17:28:00+00:00", "covers_to": "2026-10-02T17:29:00+00:00", "next_epoch": 1790962140, "schedule": [{"starts_at": "2026-10-02T17:28:00+00:00", "duration_seconds": 11, "queue_number": 55651, "sprite_key": "deer_culture", "district": "songshan", "topic": "體育", "content": "台北體育館的羽球場常常被比賽或是教練佔滿，我想要更簡單的租借場地方式。", "display_name": "松山代表 No.55,651", "mood": "caring", "is_replay": false}, {"starts_at": "2026-10-02T17:28:11+00:00", "duration_seconds": 11, "type": "padding", "queue_number": 1677, "sprite_key": "beaver_culture", "district": "zhongshan", "topic": "城市修繕", "content": "公園裡的樹，路上的樹，可以不要修的那麼醜嗎？剪到樹都禿頭了還砍樹！", "display_name": "中山代表 No.1,677", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-02T17:28:22+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 29244, "sprite_key": "turtle_culture", "district": "daan", "topic": "食安", "content": "免費營養午餐，菜色不好吃，學生不捧場，造成廚餘一堆。\n10月開始廚餘又要稱重收費，學校真的頭大。", "display_name": "大安代表 No.29,244", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-02T17:28:37+00:00", "duration_seconds": 23, "type": "padding", "queue_number": 15018, "sprite_key": "beaver_suburb", "district": "shilin", "topic": "城市修繕", "content": "我們天母有一個舊市場叫做天母商場，地下部分已經荒廢許久，如果可以得到有效利用就太好了。PUMA凍蒜！", "display_name": "士林代表 No.15,018", "mood": "caring", "is_replay": true}], "queue": [{"position": 1, "queue_number": 1677, "sprite_key": "beaver_culture", "display_name": "中山代表 No.1,677", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 29244, "sprite_key": "turtle_culture", "display_name": "大安代表 No.29,244", "district": "daan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 15018, "sprite_key": "beaver_suburb", "display_name": "士林代表 No.15,018", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 7181, "sprite_key": "beaver_oldtown", "display_name": "萬華代表 No.7,181", "district":