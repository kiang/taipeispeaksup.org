{"schema_version": 1, "segment_epoch": 1792148520, "covers_from": "2026-10-16T11:02:00+00:00", "covers_to": "2026-10-16T11:03:00+00:00", "next_epoch": 1792148580, "schedule": [{"starts_at": "2026-10-16T11:02:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 40465, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "台北往基隆下班時間總是交通壅塞，如果能夠增加客運數量和減少塞車，下班就不再感覺那麼痛苦跟辛苦，謝謝", "display_name": "內湖代表 No.40,465", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-16T11:02:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 23122, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "我每天走路都要繞過很多紅線臨停的車，有爸媽送小孩，有店家進貨，我想標線的規劃應該要考慮各種人的方便性", "display_name": "大安代表 No.23,122", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-16T11:02:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 41338, "sprite_key": "beaver_oldtown", "district": "datong", "topic": "城市修繕", "content": "台北是一個容易下雨、偏濕的城市，為何騎樓的地板、磁磚都很滑，下雨天的時候超容易滑倒，好像都沒標準似的", "display_name": "大同代表 No.41,338", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-16T11:02:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 50407, "sprite_key": "beaver_culture", "district": "zhongshan", "topic": "城市修繕", "content": "都更的速度也太慢了吧", "display_name": "中山代表 No.50,407", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 23122, "sprite_key": "squirrel_culture", "display_name": "大安代表 No.23,122", "district": "daan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 41338, "sprite_key": "beaver_oldtown", "display_name": "大同代表 No.41,338", "district": "datong", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 50407, "sprite_key": "beaver_culture", "display_name": "中山代表 No.50,407", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 27787, "sprite_key": "squirrel_culture", "display_name":