{"schema_version": 1, "segment_epoch": 1792339200, "covers_from": "2026-10-18T16:00:00+00:00", "covers_to": "2026-10-18T16:01:00+00:00", "next_epoch": 1792339260, "schedule": [{"starts_at": "2026-10-18T16:00:00+00:00", "duration_seconds": 15, "queue_number": 67311, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "解決作息無法配合垃圾車時間的問題\n恢復放置垃圾桶，兼具市容美感\n增加垃圾分類與煙蒂熄滅收集功能\n謝謝", "display_name": "士林代表 Caroline. C泯錞ㄔㄨㄣˊ✨", "mood": "caring", "is_replay": false}, {"starts_at": "2026-10-18T16:00:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 8194, "sprite_key": "turtle_business", "district": "xinyi", "topic": "食安", "content": "請問可以好好把關各個學校的營養午餐廠商嗎？預算可以高一點嗎？不希望孩子每天營養午餐吃的像ㄆㄨㄣ一樣。", "display_name": "信義代表 ErynneLin", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-18T16:00:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 12414, "sprite_key": "giraffe_oldtown", "district": "datong", "topic": "其他", "content": "敬老卡點數是給長者的福利但我們使用的幾會幾乎不多，不知長者是否能有個小確幸用敬老卡點數至超商換杯咖啡", "display_name": "大同代表 No.12,414", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-18T16:00:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 63364, "sprite_key": "turtle_suburb", "district": "beitou", "topic": "醫療", "content": "我是朝九晚五的上班族，工作不好請假。希望能在下班後去社區醫院或大醫院用健保掛號看診、週末照胃鏡", "display_name": "北投代表 No.63,364", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 8194, "sprite_key": "turtle_business", "display_name": "信義代表 ErynneLin", "district": "xinyi", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 12414, "sprite_key": "giraffe_oldtown", "display_name": "大同代表 No.12,414", "district": "datong", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 63364, "sprite_key": "turtle_suburb", "display_name": "北投代表 No.63,364", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 24150, "sprite_key": "squirrel_cultur