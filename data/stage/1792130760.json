{"schema_version": 1, "segment_epoch": 1792130760, "covers_from": "2026-10-16T06:06:00+00:00", "covers_to": "2026-10-16T06:07:00+00:00", "next_epoch": 1792130820, "schedule": [{"starts_at": "2026-10-16T06:06:00+00:00", "duration_seconds": 15, "queue_number": 65673, "sprite_key": "leopardcat_oldtown", "district": "wanhua", "topic": "環境", "content": "居住在萬華區西園路\n每年都被老鼠入侵住宅，每次都要花錢抓老鼠，我對老鼠有恐慌 老鼠已入侵第四天怎麼辦", "display_name": "萬華代表 No.65,673", "mood": "angry", "is_replay": false}, {"starts_at": "2026-10-16T06:06:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 49273, "sprite_key": "leopardcat_culture", "district": "songshan", "topic": "環境", "content": "垃圾桶也減少太多了，吃完的食物包裝袋要一路手黏黏的拎著……或許要防範亂丟家庭垃圾，但總有其他解方吧？", "display_name": "松山代表 No.49,273", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-16T06:06:30+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 15595, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "榮星花園靠馬路測有很多老樹生長到路面地磚起伏變形、影響到走路、慢跑的人的安全。", "display_name": "中山代表 No.15,595", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-16T06:06:42+00:00", "duration_seconds": 18, "type": "padding", "queue_number": 22453, "sprite_key": "penguin_business", "district": "neihu", "topic": "育兒", "content": "跟孩子說現在每天都要在學校吃營養午餐，結果孩子說：「蛤～可是學校營養午餐很難吃耶！」難吃就會有廚餘啊", "display_name": "內湖代表 No.22,453", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 49273, "sprite_key": "leopardcat_culture", "display_name": "松山代表 No.49,273", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 15595, "sprite_key": "leopardcat_culture", "display_name": "中山代表 No.15,595", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 22453, "sprite_key": "penguin_business", "display_name": "內湖代表 No.22,453", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 22123, "sprite_key": "be