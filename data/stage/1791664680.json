{"schema_version": 1, "segment_epoch": 1791664680, "covers_from": "2026-10-10T20:38:00+00:00", "covers_to": "2026-10-10T20:39:00+00:00", "next_epoch": 1791664740, "schedule": [{"starts_at": "2026-10-10T20:38:00+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 23097, "sprite_key": "penguin_oldtown", "district": "datong", "topic": "育兒", "content": "小孩說營養午餐很難吃，都沒吃幾口，我要的是小孩願意吃，不是免費的噴。。。。。。", "display_name": "大同代表 No.23,097", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-10T20:38:12+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 12293, "sprite_key": "squirrel_culture", "district": "songshan", "topic": "交通", "content": "希望台北市有更有善方便的停車環境與機制～", "display_name": "松山代表 No.12,293", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-10T20:38:18+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 41378, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "北市道路欠缺偏心左轉車道，內側直行常突變左轉道，逼得駕駛右切引發擦撞。請盡速改善標線！", "display_name": "大安代表 No.41,378", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-10T20:38:32+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 54566, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "公車緩開車、莫急停、轉彎一定要停車再開、落實指差原則。公車上的到站說明要更親民讓觀光客也能聽懂看懂。", "display_name": "大安代表 No.54,566", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-10T20:38:47+00:00", "duration_seconds": 13, "type": "padding", "queue_number": 20667, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "在公園裡希望有寵物友善的活動空間。例如在大安森林公園有讓狗狗自由活動空間的設計", "display_name": "大安代表 Shih-Hsien Yu", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 12293, "sprite_key": "squirrel_culture", "display_name": "松山代表 No.12,293", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 41378, "sprite_key": "squirrel_culture", "display_name": "大安代表 No.41,378", "district": "d