{"schema_version": 1, "segment_epoch": 1791936360, "covers_from": "2026-10-14T00:06:00+00:00", "covers_to": "2026-10-14T00:07:00+00:00", "next_epoch": 1791936420, "schedule": [{"starts_at": "2026-10-14T00:06:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 46683, "sprite_key": "beaver_oldtown", "district": "zhongzheng", "topic": "城市修繕", "content": "老屋還盼不到都更，人就離開了。\n在外還怕被老屋外牆瓷磚扎。馬路重鋪時，沒有完整規劃也鋪得很醜！", "display_name": "中正代表 No.46,683", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-14T00:06:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 470, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "臺北市還是有老鼠的蹤跡，辦公室裡防不慎防，都已經找專業治鼠公司了。也害我現在都不敢去公園散步。", "display_name": "中山代表 No.470", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-14T00:06:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 18162, "sprite_key": "penguin_suburb", "district": "shilin", "topic": "育兒", "content": "目前有三個孩子唸國小，不管挑不挑食都不喜歡營養午餐\n我希望孩子下課回來跟我分享營養午餐很好吃🥹", "display_name": "士林代表 Sylvia Chang", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-14T00:06:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 37929, "sprite_key": "bear_oldtown", "district": "datong", "topic": "勞工", "content": "減少市府派遣人員比例，要嘛就正式聘僱；聘僱契約依考績延長聘期，依勞基法給退休金。公務員比例只須1/3", "display_name": "大同代表 No.37,929", "mood": "caring", "is_replay": true}], "queue": [{"position": 1, "queue_number": 470, "sprite_key": "leopardcat_culture", "display_name": "中山代表 No.470", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 18162, "sprite_key": "penguin_suburb", "display_name": "士林代表 Sylvia Chang", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 37929, "sprite_key": "bear_oldtown", "display_name": "大同代表 No.37,929", "district": "datong", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 63670, "sprite_key": "s