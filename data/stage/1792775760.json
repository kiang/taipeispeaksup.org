{"schema_version": 1, "segment_epoch": 1792775760, "covers_from": "2026-10-23T17:16:00+00:00", "covers_to": "2026-10-23T17:17:00+00:00", "next_epoch": 1792775820, "schedule": [{"starts_at": "2026-10-23T17:16:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 14531, "sprite_key": "leopardcat_suburb", "district": "wenshan", "topic": "環境", "content": "貓空除了觀光之外，也很適合規劃給跑者還有登山客友善的環境，可以規劃相關的跑路線以及腳踏車道，運動驛站", "display_name": "文山代表 陳昱斌（萬芳骨科）", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-23T17:16:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 10715, "sprite_key": "beaver_culture", "district": "daan", "topic": "城市修繕", "content": "道路磁磚都破破鬆鬆的，下雨踩到水會整個噴起來，長輩走路也會被絆倒，還有垃圾廚餘汁都屯在裡面...很髒", "display_name": "大安代表 No.10,715", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-23T17:16:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 13443, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "小學附近的騎樓請禁止停放機車。下雨時，所有學生都擠在騎樓，走路都沒空間，小朋友拿著雨傘，常常戳到別人", "display_name": "內湖代表 No.13,443", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-23T17:16:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 48268, "sprite_key": "beaver_oldtown", "district": "datong", "topic": "城市修繕", "content": "迪化街二段都更遲遲未動，房子被徵收了10幾年，土地空著生雜草，落後潮濕，被徵收人辛苦，我們要明亮環境", "display_name": "大同代表 Celine 怡萍", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 10715, "sprite_key": "beaver_culture", "display_name": "大安代表 No.10,715", "district": "daan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 13443, "sprite_key": "squirrel_business", "display_name": "內湖代表 No.13,443", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 48268, "sprite_key": "beaver_oldtown", "display_name": "大同代表 Celine 怡萍", "district": "datong", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 13899, "sprite_key":