{"schema_version": 1, "segment_epoch": 1792825080, "covers_from": "2026-10-24T06:58:00+00:00", "covers_to": "2026-10-24T06:59:00+00:00", "next_epoch": 1792825140, "schedule": [{"starts_at": "2026-10-24T06:58:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 17618, "sprite_key": "leopardcat_business", "district": "nangang", "topic": "環境", "content": "南港區研究院路一段騎樓下都是摩托車擺放,壓迫到行人走路的路權及萬一發生火災阻斷住戶的緊急出入口。謝謝", "display_name": "南港代表 No.17,618", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-24T06:58:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 35791, "sprite_key": "turtle_suburb", "district": "wenshan", "topic": "醫療", "content": "我在萬芳工作也有20年以上了，屋齡老舊擴建腹地內裝的改善，需要市府的鞭策與協助，希望會有新的萬芳醫院", "display_name": "文山代表 No.35,791", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-24T06:58:30+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 3542, "sprite_key": "penguin_culture", "district": "daan", "topic": "其他", "content": "東區是不是沒落了，房價太貴，好多空的店面真的好浪費…", "display_name": "大安代表 No.3,542", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-24T06:58:39+00:00", "duration_seconds": 21, "type": "padding", "queue_number": 50312, "sprite_key": "penguin_culture", "district": "songshan", "topic": "教育", "content": "台北市教育局給的生理用品補助只到高一，高二高三就沒有了。為什麼生理用品的普遍性不及營養午餐跟免費鮮奶", "display_name": "松山代表 No.50,312", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 35791, "sprite_key": "turtle_suburb", "display_name": "文山代表 No.35,791", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 3542, "sprite_key": "penguin_culture", "display_name": "大安代表 No.3,542", "district": "daan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 50312, "sprite_key": "penguin_culture", "display_name": "松山代表 No.50,312", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 34149, "sprite_key": "penguin_oldtown", "display_na