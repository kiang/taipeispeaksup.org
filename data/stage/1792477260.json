{"schema_version": 1, "segment_epoch": 1792477260, "covers_from": "2026-10-20T06:21:00+00:00", "covers_to": "2026-10-20T06:22:00+00:00", "next_epoch": 1792477320, "schedule": [{"starts_at": "2026-10-20T06:21:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 33162, "sprite_key": "beaver_business", "district": "xinyi", "topic": "城市修繕", "content": "台灣人買房執念重台北房價又極高，有沒有什麼辦法讓台北變得跟歐洲城市一樣能習慣租屋，且可以安心長租呢？", "display_name": "信義代表 No.33,162", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-20T06:21:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 42546, "sprite_key": "squirrel_business", "district": "xinyi", "topic": "交通", "content": "我想讓市長知道，希望市政府能廣建公共停車場，不管是機車、腳踏車、汽車都應該有停車位，不應該停靠路邊！", "display_name": "信義代表 No.42,546", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-20T06:21:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 27329, "sprite_key": "beaver_suburb", "district": "beitou", "topic": "城市修繕", "content": "每天走唭哩岸到石牌捷運下方步道，遇到大雨就會積水嚴重，鞋子立刻淪陷！希望能強化步道平整與排水功能性！", "display_name": "北投代表 Rico Hsin", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-20T06:21:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 4449, "sprite_key": "squirrel_oldtown", "district": "zhongzheng", "topic": "交通", "content": "什麼時候開放重機停機車格？", "display_name": "中正代表 No.4,449", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 42546, "sprite_key": "squirrel_business", "display_name": "信義代表 No.42,546", "district": "xinyi", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 27329, "sprite_key": "beaver_suburb", "display_name": "北投代表 Rico Hsin", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 4449, "sprite_key": "squirrel_oldtown", "display_name": "中正代表 No.4,449", "district": "zhongzheng", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 9476, "sprite_key": "squirrel_culture", "display_name