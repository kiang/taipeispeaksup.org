{"schema_version": 1, "segment_epoch": 1790501940, "covers_from": "2026-09-27T09:39:00+00:00", "covers_to": "2026-09-27T09:40:00+00:00", "next_epoch": 1790502000, "schedule": [{"starts_at": "2026-09-27T09:39:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 34347, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "我住在松江南京捷運站附近，這裡野鴿為患，陽台築巢，到處有鴿糞，鴿子身上的禽蟎入屋咬人過敏，希望解決。", "display_name": "中山代表 No.34,347", "mood": "worried", "is_replay": true}, {"starts_at": "2026-09-27T09:39:15+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 5560, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "行人垃圾桶大量消失。 遛狗都沒辦法丟狗狗的便便。 但我也討厭亂丟居家垃圾在行人垃圾桶的人", "display_name": "士林代表 No.5,560", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-09-27T09:39:29+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 46913, "sprite_key": "deer_culture", "district": "songshan", "topic": "體育", "content": "運動對我來說太難，但之前看到有一些數位科技結合運動，如果台北市有多一點地方可以玩的話，我會更願意運動", "display_name": "松山代表 No.46,913", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-27T09:39:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 14160, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "希望回復\n設置垃圾桶", "display_name": "大安代表 No.14,160", "mood": "caring", "is_replay": true}], "queue": [{"position": 1, "queue_number": 5560, "sprite_key": "leopardcat_suburb", "display_name": "士林代表 No.5,560", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 46913, "sprite_key": "deer_culture", "display_name": "松山代表 No.46,913", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 14160, "sprite_key": "leopardcat_culture", "display_name": "大安代表 No.14,160", "district": "daan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 45747, "sprite_key": "squirrel_suburb", "display_name": "北投代表