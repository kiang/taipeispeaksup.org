{"schema_version": 1, "segment_epoch": 1791833700, "covers_from": "2026-10-12T19:35:00+00:00", "covers_to": "2026-10-12T19:36:00+00:00", "next_epoch": 1791833760, "schedule": [{"starts_at": "2026-10-12T19:35:00+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 27700, "sprite_key": "squirrel_business", "district": "xinyi", "topic": "交通", "content": "光復國小早上都借國父紀念館部分場地接送小孩，但是交通還是打結！下雨天更是塞到一個不行！", "display_name": "信義代表 No.27,700", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-12T19:35:14+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 45625, "sprite_key": "beaver_culture", "district": "daan", "topic": "城市修繕", "content": "我的房子在大安區，已經超過60年了，但要整合都更仍然遙遙無期，請問是否能夠有更有效率的方式推動都更？", "display_name": "大安代表 Raymond Liu", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-12T19:35:29+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 61626, "sprite_key": "squirrel_business", "district": "nangang", "topic": "交通", "content": "我是騎車的上班族、我覺得台北市公車真的很影響交通、當公車行駛中在我前方時也會擋到號誌燈、要如何處理呢", "display_name": "南港代表 No.61,626", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-12T19:35:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 7959, "sprite_key": "giraffe_oldtown", "district": "datong", "topic": "其他", "content": "過去這幾年暑假大稻埕煙火都施放很多次，但附近的的道路其實都很窄，對於在當地的居民生活上影響很困。", "display_name": "大同代表 No.7,959", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 45625, "sprite_key": "beaver_culture", "display_name": "大安代表 Raymond Liu", "district": "daan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 61626, "sprite_key": "squirrel_business", "display_name": "南港代表 No.61,626", "district": "nangang", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 7959, "sprite_key": "giraffe_oldtown", "display_name": "大同代表 No.7,959", "district": "datong", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 24524, "sprite_key": "leopard