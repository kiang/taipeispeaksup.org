{"schema_version": 1, "segment_epoch": 1790998680, "covers_from": "2026-10-03T03:38:00+00:00", "covers_to": "2026-10-03T03:39:00+00:00", "next_epoch": 1790998740, "schedule": [{"starts_at": "2026-10-03T03:38:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 26259, "sprite_key": "leopardcat_oldtown", "district": "wanhua", "topic": "環境", "content": "我是住新北土城中央路自從去年一整年把整個1段2段馬路拓寬把每顆樹🌲砍光光.整個馬路一顆也沒有轉巧慧", "display_name": "萬華代表 麗鳳", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-03T03:38:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 5069, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "台北市市容越來越髒亂，很多地方，垃圾滿地，這太丟臉了！我的座標天母，草叢、轉角有垃圾也有煙蒂，麻煩了", "display_name": "士林代表 April Liu", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-03T03:38:30+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 44971, "sprite_key": "beaver_suburb", "district": "shilin", "topic": "城市修繕", "content": "台北市太舊了，台北市的都更8箭根本無法有效推動，就應該再優化放寬各項條件，市府官員該醒醒了", "display_name": "士林代表 Wei", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-03T03:38:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 35910, "sprite_key": "leopardcat_business", "district": "xinyi", "topic": "環境", "content": "餐廳油煙及噪音管理，希望能夠有效管理。", "display_name": "信義代表 No.35,910", "mood": "caring", "is_replay": true}], "queue": [{"position": 1, "queue_number": 5069, "sprite_key": "leopardcat_suburb", "display_name": "士林代表 April Liu", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 44971, "sprite_key": "beaver_suburb", "display_name": "士林代表 Wei", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 35910, "sprite_key": "leopardcat_business", "display_name": "信義代表 No.35,910", "district": "xinyi", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 50439, "sprite_key": "leopardcat_oldtown", "display_name": "大同代表 No.50,439"