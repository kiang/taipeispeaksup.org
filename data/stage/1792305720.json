{"schema_version": 1, "segment_epoch": 1792305720, "covers_from": "2026-10-18T06:42:00+00:00", "covers_to": "2026-10-18T06:43:00+00:00", "next_epoch": 1792305780, "schedule": [{"starts_at": "2026-10-18T06:42:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 60419, "sprite_key": "turtle_suburb", "district": "wenshan", "topic": "醫療", "content": "護病比政策造成北市很多醫院有病房但開不了，建議市府可以直接給病房護理師薪資補助，讓北市病患等得到病房", "display_name": "文山代表 Robin Lin", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-18T06:42:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 2584, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "在禁止抽煙範圍外抽煙（像騎樓）就算吸煙者真的在範圍外抽，味道還是會飄進來。這方面的規範真的蠻不明的。", "display_name": "中山代表 No.2,584", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-18T06:42:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 16528, "sprite_key": "squirrel_culture", "district": "songshan", "topic": "交通", "content": "身為民生社區的公車族，從社區搭公車到松山機場轉捷運非常的便利，不過從機場回社區則是沒有。請問有何解方", "display_name": "松山代表 No.16,528", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-18T06:42:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 60511, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "關於客運及公車，有沒有可能依路段的大小來限制客運及公車在同一時間同一路段的數量。", "display_name": "大安代表 No.60,511", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 2584, "sprite_key": "leopardcat_culture", "display_name": "中山代表 No.2,584", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 16528, "sprite_key": "squirrel_culture", "display_name": "松山代表 No.16,528", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 60511, "sprite_key": "squirrel_culture", "display_name": "大安代表 No.60,511", "district": "daan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 66924, "sprite_key": "