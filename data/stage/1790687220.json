{"schema_version": 1, "segment_epoch": 1790687220, "covers_from": "2026-09-29T13:07:00+00:00", "covers_to": "2026-09-29T13:08:00+00:00", "next_epoch": 1790687280, "schedule": [{"starts_at": "2026-09-29T13:07:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 33126, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "大安區即使沒有老鼠，晚上也到處蟑螂爬行。外國觀光客在脆上也問，台北為何蟑螂那麼多？首善之都丟進國家臉", "display_name": "大安代表 No.33,126", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-29T13:07:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 44558, "sprite_key": "squirrel_culture", "district": "zhongshan", "topic": "交通", "content": "人行道禁行機車，卻劃車格允許停車，弔詭的邏輯與設計不但行人危險，更易養成駕駛壞習慣，應當重新規劃設計", "display_name": "中山代表 No.44,558", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-29T13:07:30+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 51727, "sprite_key": "squirrel_oldtown", "district": "wanhua", "topic": "交通", "content": "道路旁紅黃標線可以像國外和其他縣市一樣，劃在道路旁而不要劃在行人道路緣石上，這樣才能更美觀", "display_name": "萬華代表 No.51,727", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-29T13:07:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 51201, "sprite_key": "beaver_oldtown", "district": "datong", "topic": "城市修繕", "content": "我是住在台北市最早開發的大同區，我們的屋齡都已經超過60年，我們希望市府能幫大家規劃都更。", "display_name": "大同代表 No.51,201", "mood": "caring", "is_replay": true}], "queue": [{"position": 1, "queue_number": 44558, "sprite_key": "squirrel_culture", "display_name": "中山代表 No.44,558", "district": "zhongshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 51727, "sprite_key": "squirrel_oldtown", "display_name": "萬華代表 No.51,727", "district": "wanhua", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 51201, "sprite_key": "beaver_oldtown", "display_name": "大同代表 No.51,201", "district": "datong", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 36672, "sprite_key": "squir