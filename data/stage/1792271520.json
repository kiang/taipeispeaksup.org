{"schema_version": 1, "segment_epoch": 1792271520, "covers_from": "2026-10-17T21:12:00+00:00", "covers_to": "2026-10-17T21:13:00+00:00", "next_epoch": 1792271580, "schedule": [{"starts_at": "2026-10-17T21:12:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 7629, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "一直到柯文哲時代我在路上都很常看到清潔人員清潔或是除塵車在路上 現在為什麼都沒了 路上垃圾好多", "display_name": "大安代表 No.7,629", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-17T21:12:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 48891, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "我常在下班時間五點半從南港騎河濱到關渡碼頭,不用60分鐘，有屋頂的空中自行車道對交通，運動的市民大加", "display_name": "內湖代表 閃靈Jacky", "mood": "positive", "is_replay": true}, {"starts_at": "2026-10-17T21:12:30+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 38593, "sprite_key": "beaver_culture", "district": "daan", "topic": "城市修繕", "content": "台北市容真是又老又醜", "display_name": "大安代表 Sue", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-17T21:12:35+00:00", "duration_seconds": 25, "type": "padding", "queue_number": 45221, "sprite_key": "leopardcat_business", "district": "neihu", "topic": "環境", "content": "不是說「無菸城市」為什麼反而在馬路邊以及人行道上越來越容易看到吸菸者，難道不能讓不吸菸者跟吸菸者分流", "display_name": "內湖代表 No.45,221", "mood": "caring", "is_replay": true}], "queue": [{"position": 1, "queue_number": 48891, "sprite_key": "squirrel_business", "display_name": "內湖代表 閃靈Jacky", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 38593, "sprite_key": "beaver_culture", "display_name": "大安代表 Sue", "district": "daan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 45221, "sprite_key": "leopardcat_business", "display_name": "內湖代表 No.45,221", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 46643, "sprite_key": "squirrel_business", "display_name": "南港代表 No.46,643", "di