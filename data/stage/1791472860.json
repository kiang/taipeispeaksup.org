{"schema_version": 1, "segment_epoch": 1791472860, "covers_from": "2026-10-08T15:21:00+00:00", "covers_to": "2026-10-08T15:22:00+00:00", "next_epoch": 1791472920, "schedule": [{"starts_at": "2026-10-08T15:21:00+00:00", "duration_seconds": 15, "queue_number": 59338, "sprite_key": "bear_business", "district": "neihu", "topic": "其他", "content": "工作在內湖老家在桃園希望可以就近通勤 不能申請社宅 買不起房 房東不給租補 檢舉就沒地方住 怎麼辦", "display_name": "內湖代表 Joyce", "mood": "hopeful", "is_replay": false}, {"starts_at": "2026-10-08T15:21:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 59230, "sprite_key": "penguin_culture", "district": "daan", "topic": "教育", "content": "Hi\n有太多人抨擊特殊生，但我們知道是融合教育配套不足，希望北市能成為身心障礙孩子能安心就學的地方。", "display_name": "大安代表 No.59,230", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-08T15:21:30+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 45855, "sprite_key": "penguin_culture", "district": "daan", "topic": "育兒", "content": "親子活動的空間及育兒場所實在太少了了，尤其公共場所對於帶著幼兒的父母許多地方都不是太友善", "display_name": "大安代表 No.45,855", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-08T15:21:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 46815, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "我在內湖上班，住中山區，每天都會開車上班，因為每天都先會載老婆去士林上班，像我們就不可能騎腳踏車上班", "display_name": "內湖代表 No.46,815", "mood": "positive", "is_replay": true}], "queue": [{"position": 1, "queue_number": 59230, "sprite_key": "penguin_culture", "display_name": "大安代表 No.59,230", "district": "daan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 45855, "sprite_key": "penguin_culture", "display_name": "大安代表 No.45,855", "district": "daan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 46815, "sprite_key": "squirrel_business", "display_name": "內湖代表 No.46,815", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 7241, "sprite_key": "deer_culture", "display_name": "大安代表