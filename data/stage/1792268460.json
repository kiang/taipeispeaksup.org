{"schema_version": 1, "segment_epoch": 1792268460, "covers_from": "2026-10-17T20:21:00+00:00", "covers_to": "2026-10-17T20:22:00+00:00", "next_epoch": 1792268520, "schedule": [{"starts_at": "2026-10-17T20:21:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 8993, "sprite_key": "penguin_suburb", "district": "shilin", "topic": "教育", "content": "營養午餐我不在意免費，付錢也沒有關係，小屁孩不再回來一直抱怨\n吵著社畜老木要幫他準備便當⋯\n我好為難", "display_name": "士林代表 No.8,993", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-17T20:21:15+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 10101, "sprite_key": "squirrel_suburb", "district": "wenshan", "topic": "交通", "content": "希望ubike通勤的時候有連續的自行車道可以騎，以及增加捷運的拉環和座位數量！", "display_name": "文山代表 No.10,101", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-17T20:21:27+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 17594, "sprite_key": "leopardcat_culture", "district": "songshan", "topic": "環境", "content": "希望種多一點樹，解決鼠蟑肆虐", "display_name": "松山代表 No.17,594", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-17T20:21:32+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 7211, "sprite_key": "deer_culture", "district": "zhongshan", "topic": "其他", "content": "拜託颱風天風大雨大可以即時宣布休假，通勤上班很辛苦也很克難。", "display_name": "中山代表 No.7,211", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-17T20:21:41+00:00", "duration_seconds": 19, "type": "padding", "queue_number": 23911, "sprite_key": "deer_suburb", "district": "shilin", "topic": "觀光", "content": "去年去熊野古道 途中很多王子（神社）增添樂趣，台北大縱走，也很多土地公廟，有機會整合變賣點？", "display_name": "士林代表 No.23,911", "mood": "positive", "is_replay": true}], "queue": [{"position": 1, "queue_number": 10101, "sprite_key": "squirrel_suburb", "display_name": "文山代表 No.10,101", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 17594, "sprite_key": "leopardcat_culture", "display_name": "松山代表 No.17,594", "district": "songshan", "i