{"schema_version": 1, "segment_epoch": 1791922380, "covers_from": "2026-10-13T20:13:00+00:00", "covers_to": "2026-10-13T20:14:00+00:00", "next_epoch": 1791922440, "schedule": [{"starts_at": "2026-10-13T20:13:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 32892, "sprite_key": "beaver_suburb", "district": "wenshan", "topic": "城市修繕", "content": "人行道問題：例如：有些人道路面是斜的、凹凸不平整、走一走沒人行道、有盆栽，詳細可看企鵝妹遊台灣直播。", "display_name": "文山代表 No.32,892", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-13T20:13:15+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 13903, "sprite_key": "beaver_suburb", "district": "wenshan", "topic": "城市修繕", "content": "電線桿地下化，我要寬敞人行道", "display_name": "文山代表 HY.Pang", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-13T20:13:20+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 38855, "sprite_key": "squirrel_oldtown", "district": "datong", "topic": "交通", "content": "什麼時候機車可以在大路直接左轉？", "display_name": "大同代表 No.38,855", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-13T20:13:26+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 7546, "sprite_key": "beaver_culture", "district": "zhongshan", "topic": "城市修繕", "content": "許多公園（像中山區的榮星花園公園）很少除草。大草皮草長得很高，很不衛生，也沒辦法在草皮上休閒活動", "display_name": "中山代表 No.7,546", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-13T20:13:41+00:00", "duration_seconds": 19, "type": "padding", "queue_number": 45358, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "9/16 一早剛出家門就遇到人行道兩邊內側及外側都有人抽菸，接下來走去捷運站又有人邊走邊抽菸😡", "display_name": "中山代表 No.45,358", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 13903, "sprite_key": "beaver_suburb", "display_name": "文山代表 HY.Pang", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 38855, "sprite_key": "squirrel_oldtown", "display_name": "大同代表 No.38,855", "district": "datong", "is_replay":