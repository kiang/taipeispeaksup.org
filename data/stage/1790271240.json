{"schema_version": 1, "segment_epoch": 1790271240, "covers_from": "2026-09-24T17:34:00+00:00", "covers_to": "2026-09-24T17:35:00+00:00", "next_epoch": 1790271300, "schedule": [{"starts_at": "2026-09-24T17:34:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 43086, "sprite_key": "elephant_business", "district": "xinyi", "topic": "市政", "content": "北捷開始有腐化的跡象，人事任命很關鍵，人才要配位，營造能做出有建設性意見的環境，別像公子的局長無能。", "display_name": "信義代表 No.43,086", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-24T17:34:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 11068, "sprite_key": "leopardcat_culture", "district": "songshan", "topic": "環境", "content": "公車站牌附近經常有人在抽煙，也很多人會邊走邊抽，無煙城市？\n還有最近發現很多人抽電子菸，合法嗎？", "display_name": "松山代表 No.11,068", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-09-24T17:34:30+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 24476, "sprite_key": "squirrel_business", "district": "nangang", "topic": "交通", "content": "ubike故障率超高，電動車也常常沒有動力，租借站常常沒車", "display_name": "南港代表 Amanda Chang", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-09-24T17:34:39+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 7247, "sprite_key": "leopardcat_oldtown", "district": "datong", "topic": "環境", "content": "老🐭老🐭老🐭，可以把老鼠趕出去台北市嗎？", "display_name": "大同代表 No.7,247", "mood": "angry", "is_replay": true}, {"starts_at": "2026-09-24T17:34:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 8204, "sprite_key": "leopardcat_culture", "district": "zhongshan", "topic": "環境", "content": "觀光景點（例如夜市）的垃圾桶應該要多一點，而且清潔頻率要提高，尤其對於外國遊客會更有感", "display_name": "中山代表 Cindy Hu", "mood": "helpless", "is_replay": true}], "queue": [{"position": 1, "queue_number": 11068, "sprite_key": "leopardcat_culture", "display_name": "松山代表 No.11,068", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 24476, "sprite_key": "squirrel_business", "display_name": "南港代表 Amanda C