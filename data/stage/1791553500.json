{"schema_version": 1, "segment_epoch": 1791553500, "covers_from": "2026-10-09T13:45:00+00:00", "covers_to": "2026-10-09T13:46:00+00:00", "next_epoch": 1791553560, "schedule": [{"starts_at": "2026-10-09T13:45:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 11386, "sprite_key": "penguin_oldtown", "district": "zhongzheng", "topic": "其他", "content": "愛爸愛媽在河濱公園或是城市其他地方放置貓狗飼料，但又不領養，造成其在外面遊蕩，並會對路人、家犬吠叫。", "display_name": "中正代表 No.11,386", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-09T13:45:15+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 2912, "sprite_key": "squirrel_business", "district": "nangang", "topic": "交通", "content": "南港的公車誤點率超級高", "display_name": "南港代表 No.2,912", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-09T13:45:20+00:00", "duration_seconds": 11, "type": "padding", "queue_number": 12429, "sprite_key": "leopardcat_oldtown", "district": "wanhua", "topic": "環境", "content": "垃圾桶真的太少了！更誇張的是連艋舺夜市也沒有，拜託！那裡是觀光夜市耶！", "display_name": "萬華代表 No.12,429", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-09T13:45:31+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 7645, "sprite_key": "leopardcat_oldtown", "district": "wanhua", "topic": "環境", "content": "我希望公車站牌或路上有垃圾桶，這幾年垃圾桶裝了又拆、拆了又裝，設置之前請先想好配套，謝謝!", "display_name": "萬華代表 No.7,645", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-09T13:45:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 45043, "sprite_key": "squirrel_suburb", "district": "wenshan", "topic": "交通", "content": "我是文山區機車族，馬路一直在挖挖補補，不論大小條都有很多坑洞跟補丁，各種交通標線碰到雨天很容易打滑！", "display_name": "文山代表 No.45,043", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 2912, "sprite_key": "squirrel_business", "display_name": "南港代表 No.2,912", "district": "nangang", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 12429, "sprite_key": "leopardcat_oldtown", "display_name": "萬華代表 No.12,429", "district