{"schema_version": 1, "segment_epoch": 1792035300, "covers_from": "2026-10-15T03:35:00+00:00", "covers_to": "2026-10-15T03:36:00+00:00", "next_epoch": 1792035360, "schedule": [{"starts_at": "2026-10-15T03:35:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 31743, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "住家後巷水溝與餐廳水溝相連，水溝裡都是油污，跟里長反映多次，商家都沒有改進里長也很無奈，\n你如何處理", "display_name": "士林代表 No.31,743", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-15T03:35:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 44535, "sprite_key": "beaver_culture", "district": "songshan", "topic": "城市修繕", "content": "松山國小前，之前颱風樹倒了之後就直接砍掉，後來發現附近的樹也都漸漸被砍掉了，整個城市綠化的樹消失了。", "display_name": "松山代表 No.44,535", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-15T03:35:30+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 57096, "sprite_key": "deer_oldtown", "district": "datong", "topic": "文化", "content": "希望讓台北展現更多的台灣文化特色··", "display_name": "大同代表 No.57,096", "mood": "positive", "is_replay": true}, {"starts_at": "2026-10-15T03:35:36+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 45215, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "可以不要再亂砍樹了嗎？", "display_name": "大安代表 No.45,215", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-15T03:35:41+00:00", "duration_seconds": 19, "type": "padding", "queue_number": 17285, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "期待台北成為綠樹城市!河流也變得像京都鴨川一樣能走進去!但這些實際做起來都很複雜 還要考慮極端氣候", "display_name": "大安代表 Sarah Ting Wei Chang", "mood": "positive", "is_replay": true}], "queue": [{"position": 1, "queue_number": 44535, "sprite_key": "beaver_culture", "display_name": "松山代表 No.44,535", "district": "songshan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 57096, "sprite_key": "deer_oldtown", "display_name": "大同代表 No.57,096", "district": "datong"