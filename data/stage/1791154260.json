{"schema_version": 1, "segment_epoch": 1791154260, "covers_from": "2026-10-04T22:51:00+00:00", "covers_to": "2026-10-04T22:52:00+00:00", "next_epoch": 1791154320, "schedule": [{"starts_at": "2026-10-04T22:51:00+00:00", "duration_seconds": 11, "queue_number": 56857, "sprite_key": "bear_oldtown", "district": "zhongzheng", "topic": "勞工", "content": "我想請問對台北火車站的遊民有什麼計劃？讓他們有機會進入社會系統。", "display_name": "中正代表 No.56,857", "mood": "helpless", "is_replay": false}, {"starts_at": "2026-10-04T22:51:11+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 10342, "sprite_key": "penguin_suburb", "district": "beitou", "topic": "教育", "content": "小朋友從出生就在阿嬷家三歲前入籍，公幼小學都沒問題，到了要上國中就被要求複審，跨學區的卻不用", "display_name": "北投代表 No.10,342", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-04T22:51:26+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 13326, "sprite_key": "penguin_oldtown", "district": "datong", "topic": "教育", "content": "可邀請不同類組的學霸（或長輩長照），分享讀書方法嗎？", "display_name": "大同代表 No.13,326", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-04T22:51:35+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 4216, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "台北市的樹一顆一顆被砍真的很心疼，期待我的沈市長把樹種回來！", "display_name": "大安代表 Grace Hsu", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-04T22:51:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 47863, "sprite_key": "penguin_business", "district": "nangang", "topic": "育兒", "content": "山水綠公園設施不少失修或待修，沙坑也長草了，這類的公園失能狀態應該不在少數，希望可以恢復或重新規劃", "display_name": "南港代表 No.47,863", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 10342, "sprite_key": "penguin_suburb", "display_name": "北投代表 No.10,342", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 13326, "sprite_key": "penguin_oldtown", "display_name": "大同代表 No.13,326", "district": "datong", "is_replay": true, "frozen"