{"schema_version": 1, "segment_epoch": 1790819100, "covers_from": "2026-10-01T01:45:00+00:00", "covers_to": "2026-10-01T01:46:00+00:00", "next_epoch": 1790819160, "schedule": [{"starts_at": "2026-10-01T01:45:00+00:00", "duration_seconds": 15, "queue_number": 54521, "sprite_key": "bear_culture", "district": "daan", "topic": "經濟", "content": "建議台北市於忠孝東路東區試辦週末特色市集，開放合法攤商進駐，統一管理交通、環境與攤位，重現東區活力，", "display_name": "大安代表 Chiahsun家勳", "mood": "caring", "is_replay": false}, {"starts_at": "2026-10-01T01:45:15+00:00", "duration_seconds": 11, "type": "padding", "queue_number": 40092, "sprite_key": "leopardcat_oldtown", "district": "zhongzheng", "topic": "環境", "content": "老鼠亂竄 在台北市餐廳都能看到老鼠跑過餐廳 市長得處理環境衛生問題", "display_name": "中正代表 No.40,092", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-01T01:45:26+00:00", "duration_seconds": 9, "type": "padding", "queue_number": 18, "sprite_key": "penguin_culture", "district": "songshan", "topic": "育兒", "content": "松山區公園遊具老舊，很多都封起來不能玩，小孩根本沒地方放電。", "display_name": "松山代表 No.18", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-01T01:45:35+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 29350, "sprite_key": "deer_oldtown", "district": "datong", "topic": "文化", "content": "我希望台北市能更重視尚未被指定為文化資產，但具有潛力價值的老房子，期待市府能提出誘因鼓勵市民及產權人", "display_name": "大同代表 No.29,350", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-01T01:45:50+00:00", "duration_seconds": 10, "type": "padding", "queue_number": 54456, "sprite_key": "beaver_culture", "district": "zhongshan", "topic": "城市修繕", "content": "我們購買房屋時公設算入室內坪數，且售價統一計算，很不合理", "display_name": "中山代表 古明格", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 40092, "sprite_key": "leopardcat_oldtown", "display_name": "中正代表 No.40,092", "district": "zhongzheng", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 18, "sprite_key": "penguin_culture", "display_name": "松山代表 No.18", "district": "songshan", "is_replay": true, "fro