{"schema_version": 1, "segment_epoch": 1790598600, "covers_from": "2026-09-28T12:30:00+00:00", "covers_to": "2026-09-28T12:31:00+00:00", "next_epoch": 1790598660, "schedule": [{"starts_at": "2026-09-28T12:30:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 43460, "sprite_key": "leopardcat_suburb", "district": "wenshan", "topic": "環境", "content": "我家萬隆街這邊都是老公寓，鄰居經常在前後陽台抽煙，我已飽受長年的二手煙，最近我咳嗽的很厲害，怎麼辦？", "display_name": "文山代表 Achitā 約瑾ਅਚਿਤਾ", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-09-28T12:30:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 41039, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "這城市好舊，綠地好少，公園好髒。抽菸的人還是把煙蒂往水溝、路上丟，一樓的小攤販還是把廢油往水溝偷排。", "display_name": "大安代表 No.41,039", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-09-28T12:30:30+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 24747, "sprite_key": "elephant_business", "district": "xinyi", "topic": "治安", "content": "管理好衛生局的列管名單 保護列管個案的隱私 並且增加更生人的就業輔導及社會支持", "display_name": "信義代表 No.24,747", "mood": "caring", "is_replay": true}, {"starts_at": "2026-09-28T12:30:42+00:00", "duration_seconds": 18, "type": "padding", "queue_number": 3446, "sprite_key": "leopardcat_oldtown", "district": "wanhua", "topic": "環境", "content": "龍山寺遊民及街區改造，萬華是近期國際觀光客必訪景點，卻因遊民及街廓老舊而印象不佳，希望可以翻轉萬華", "display_name": "萬華代表 No.3,446", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 41039, "sprite_key": "leopardcat_culture", "display_name": "大安代表 No.41,039", "district": "daan", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 24747, "sprite_key": "elephant_business", "display_name": "信義代表 No.24,747", "district": "xinyi", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 3446, "sprite_key": "leopardcat_oldtown", "display_name": "萬華代表 No.3,446", "district": "wanhua", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 38166, "sprite_key