{"schema_version": 1, "segment_epoch": 1791523020, "covers_from": "2026-10-09T05:17:00+00:00", "covers_to": "2026-10-09T05:18:00+00:00", "next_epoch": 1791523080, "schedule": [{"starts_at": "2026-10-09T05:17:00+00:00", "duration_seconds": 15, "queue_number": 59675, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "沈市長能否當消防車和救護車聲響時，路上車子能一致像右靠停，讓急救車能快速通過。就像美國道路規定一樣。", "display_name": "大安代表 No.59,675", "mood": "worried", "is_replay": false}, {"starts_at": "2026-10-09T05:17:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 2220, "sprite_key": "squirrel_suburb", "district": "shilin", "topic": "交通", "content": "士林區中正路一帶正在興建捷運環狀線工程，人行道變擁擠、行進路線狹窄，造成生活不便，希望能改善。", "display_name": "士林代表 No.2,220", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-09T05:17:30+00:00", "duration_seconds": 5, "type": "padding", "queue_number": 12346, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "道路標線可以更好", "display_name": "內湖代表 No.12,346", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-09T05:17:35+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 11430, "sprite_key": "leopardcat_oldtown", "district": "zhongzheng", "topic": "環境", "content": "希望城市裡多一點綠地，多一點樹，多一點大人小孩可以運動和親近大自然的地方", "display_name": "中正代表 No.11,430", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-09T05:17:47+00:00", "duration_seconds": 13, "type": "padding", "queue_number": 28570, "sprite_key": "squirrel_culture", "district": "daan", "topic": "交通", "content": "夏天的捷運味道有點重，希望站內與車廂內冷氣可以強一點。", "display_name": "大安代表 裕和", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 2220, "sprite_key": "squirrel_suburb", "display_name": "士林代表 No.2,220", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 12346, "sprite_key": "squirrel_business", "display_name": "內湖代表 No.12,346", "district": "neihu", "is_replay": true, "frozen": true}, {"posit