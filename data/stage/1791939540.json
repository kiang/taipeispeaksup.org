{"schema_version": 1, "segment_epoch": 1791939540, "covers_from": "2026-10-14T00:59:00+00:00", "covers_to": "2026-10-14T01:00:00+00:00", "next_epoch": 1791939600, "schedule": [{"starts_at": "2026-10-14T00:59:00+00:00", "duration_seconds": 15, "queue_number": 63742, "sprite_key": "leopardcat_oldtown", "district": "zhongzheng", "topic": "環境", "content": "明明已經在醫院和學校門口畫禁煙人行道了，但因為沒在抓，所以還是很多人吸煙（尤其台大醫院門口）", "display_name": "中正代表 No.63,742", "mood": "worried", "is_replay": false}, {"starts_at": "2026-10-14T00:59:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 44455, "sprite_key": "leopardcat_oldtown", "district": "datong", "topic": "環境", "content": "中山站垃圾桶雖然有減少.蟑螂也變少.但老鼠時不時還是會看見. 家住4樓.竟然看見老鼠在門上.很可怕", "display_name": "大同代表 No.44,455", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-14T00:59:30+00:00", "duration_seconds": 14, "type": "padding", "queue_number": 63700, "sprite_key": "bear_suburb", "district": "wenshan", "topic": "勞工", "content": "如果，你擔任市長，勞工退休金（純舊制）會不會依據勞基法辦理？\n如果不會，勞工該怎麼辦？", "display_name": "文山代表 No.63,700", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-14T00:59:44+00:00", "duration_seconds": 16, "type": "padding", "queue_number": 49214, "sprite_key": "bear_suburb", "district": "wenshan", "topic": "其他", "content": "垃圾桶不用多設。 但是要有固定的地方，讓居民丟垃圾，不要去等垃圾車，這才是先進城市，該有的作為。", "display_name": "文山代表 Karen", "mood": "positive", "is_replay": true}], "queue": [{"position": 1, "queue_number": 44455, "sprite_key": "leopardcat_oldtown", "display_name": "大同代表 No.44,455", "district": "datong", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 63700, "sprite_key": "bear_suburb", "display_name": "文山代表 No.63,700", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 49214, "sprite_key": "bear_suburb", "display_name": "文山代表 Karen", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 63743, "sprite_key": "bear_suburb", "display_name": "文山代表