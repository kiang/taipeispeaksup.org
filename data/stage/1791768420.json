{"schema_version": 1, "segment_epoch": 1791768420, "covers_from": "2026-10-12T01:27:00+00:00", "covers_to": "2026-10-12T01:28:00+00:00", "next_epoch": 1791768480, "schedule": [{"starts_at": "2026-10-12T01:27:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 41168, "sprite_key": "deer_suburb", "district": "wenshan", "topic": "觀光", "content": "台北的觀光景點附近都有很多醜的建築，比如說加建或鐵皮屋或廢棄物。每次帶國外朋友去都覺得好丟臉。", "display_name": "文山代表 No.41,168", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-12T01:27:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 46546, "sprite_key": "giraffe_suburb", "district": "beitou", "topic": "其他", "content": "我狗今年過世，我希望台北也能有名額公費獸醫師從開始語言學校到獸醫手術學習的進修制度，讓飼主的眼淚減少", "display_name": "北投代表 Ricky", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-12T01:27:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 47088, "sprite_key": "deer_suburb", "district": "shilin", "topic": "文化", "content": "我希望圓山明治橋趕快重建回來，那是我小時候每天坐校車去復興上學經過的橋，那是台北市美麗記憶的一部分。", "display_name": "士林代表 惠雯(31虹瑜Amanda）", "mood": "helpless", "is_replay": true}, {"starts_at": "2026-10-12T01:27:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 32696, "sprite_key": "squirrel_business", "district": "xinyi", "topic": "交通", "content": "信義計畫區的開車動線很有問題，尖峰時段車子幾乎動彈不得，平時5分鐘的路程常常要開到30分鐘以上", "display_name": "信義代表 No.32,696", "mood": "angry", "is_replay": true}], "queue": [{"position": 1, "queue_number": 46546, "sprite_key": "giraffe_suburb", "display_name": "北投代表 Ricky", "district": "beitou", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 47088, "sprite_key": "deer_suburb", "display_name": "士林代表 惠雯(31虹瑜Amanda）", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 32696, "sprite_key": "squirrel_business", "display_name": "信義代表 No.32,696", "district": "xinyi", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 61988, "sprite_key": "elephant_oldt