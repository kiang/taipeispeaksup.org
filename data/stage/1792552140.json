{"schema_version": 1, "segment_epoch": 1792552140, "covers_from": "2026-10-21T03:09:00+00:00", "covers_to": "2026-10-21T03:10:00+00:00", "next_epoch": 1792552200, "schedule": [{"starts_at": "2026-10-21T03:09:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 56116, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "磺溪彩虹健康步道從文林北路石牌橋至天母西路磺溪橋即中斷。拜託延伸至天母公園的可行性，形成完整綠廊道", "display_name": "士林代表 No.56,116", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-21T03:09:15+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 17782, "sprite_key": "leopardcat_business", "district": "neihu", "topic": "環境", "content": "亂餵食鴿子、公園裡的魚、街貓狗的狀況還是很多，有人會亂摘公園的花，上前勸也不聽，超沒公德心。", "display_name": "內湖代表 No.17,782", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-21T03:09:30+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 49308, "sprite_key": "leopardcat_suburb", "district": "wenshan", "topic": "環境", "content": "台北應改用智慧地下集運與按重扣款子母車。不用專用袋、免追垃圾車，刷卡按重扣款，也解決公共垃圾桶問題", "display_name": "文山代表 No.49,308", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-21T03:09:45+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 4772, "sprite_key": "leopardcat_suburb", "district": "shilin", "topic": "環境", "content": "拜託可以不要再砍樹了嗎？若真的要砍也要在樹旁公告原因跟處理過程，讓民眾了解為何砍", "display_name": "士林代表 No.4,772", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 17782, "sprite_key": "leopardcat_business", "display_name": "內湖代表 No.17,782", "district": "neihu", "is_replay": true, "frozen": true}, {"position": 2, "queue_number": 49308, "sprite_key": "leopardcat_suburb", "display_name": "文山代表 No.49,308", "district": "wenshan", "is_replay": true, "frozen": true}, {"position": 3, "queue_number": 4772, "sprite_key": "leopardcat_suburb", "display_name": "士林代表 No.4,772", "district": "shilin", "is_replay": true, "frozen": true}, {"position": 4, "queue_number": 68435, "sprite_key": "peng