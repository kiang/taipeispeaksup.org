{"schema_version": 1, "segment_epoch": 1791395760, "covers_from": "2026-10-07T17:56:00+00:00", "covers_to": "2026-10-07T17:57:00+00:00", "next_epoch": 1791395820, "schedule": [{"starts_at": "2026-10-07T17:56:00+00:00", "duration_seconds": 15, "type": "padding", "queue_number": 8811, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "台北市的公車老舊，公車內的座位亂七八糟，一下向前、向後、側邊、後方座位設立在輪匡上，腳無處放！", "display_name": "內湖代表 No.8,811", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-07T17:56:15+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 32676, "sprite_key": "squirrel_business", "district": "neihu", "topic": "交通", "content": "希望能有更多停車位 哪怕付費也沒關係", "display_name": "內湖代表 No.32,676", "mood": "caring", "is_replay": true}, {"starts_at": "2026-10-07T17:56:21+00:00", "duration_seconds": 6, "type": "padding", "queue_number": 19343, "sprite_key": "beaver_suburb", "district": "wenshan", "topic": "城市修繕", "content": "人行道不平，下雨天很滑，我滑倒好多次。", "display_name": "文山代表 No.19,343", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-07T17:56:27+00:00", "duration_seconds": 11, "type": "padding", "queue_number": 23477, "sprite_key": "leopardcat_culture", "district": "daan", "topic": "環境", "content": "為什麼我們生活的地方、工作的地方老鼠都這麼猖獗，這裡是臺北市誒！", "display_name": "大安代表 No.23,477", "mood": "angry", "is_replay": true}, {"starts_at": "2026-10-07T17:56:38+00:00", "duration_seconds": 12, "type": "padding", "queue_number": 5343, "sprite_key": "leopardcat_business", "district": "neihu", "topic": "環境", "content": "一個每天走在台北街頭的市民，還能不能在路邊找到一棵樹，讓自己稍微乘一下涼？", "display_name": "內湖代表 No.5,343", "mood": "worried", "is_replay": true}, {"starts_at": "2026-10-07T17:56:50+00:00", "duration_seconds": 10, "type": "padding", "queue_number": 33573, "sprite_key": "beaver_culture", "district": "songshan", "topic": "城市修繕", "content": "讓台北朝氣勃勃好嗎", "display_name": "松山代表 B", "mood": "worried", "is_replay": true}], "queue": [{"position": 1, "queue_number": 32676, "sprite_key": "squi